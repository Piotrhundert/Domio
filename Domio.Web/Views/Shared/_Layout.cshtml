@using Domio.Application.Authorization
@using Domio.Domain.Users
@{
    var canViewUsers =
        User.HasClaim(
            DomioClaimTypes.Permission,
            SystemPermissions.UsersView);

    var canViewRoles =
        User.HasClaim(
            DomioClaimTypes.Permission,
            SystemPermissions.RolesView);

    var canViewOwnProfile =
        User.HasClaim(
            DomioClaimTypes.Permission,
            SystemPermissions.ProfileViewOwn) ||
        User.HasClaim(
            DomioClaimTypes.Permission,
            SystemPermissions.ProfileViewAll);

    var canViewPersonalFinance =
        User.HasClaim(
            DomioClaimTypes.Permission,
            SystemPermissions.FinancePersonalViewOwn);

    var canViewHouseholdFinance =
        User.HasClaim(
            DomioClaimTypes.Permission,
            SystemPermissions.FinanceHouseholdView);
}
<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Domio</title>
    <script type="importmap"></script>
    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
    <link rel="stylesheet"
          href="~/css/users.css"
          asp-append-version="true" />
    <link rel="stylesheet"
          href="~/css/personal-finance.css"
          asp-append-version="true" />
    <link rel="stylesheet"
          href="~/css/household-finance.css"
          asp-append-version="true" />
    <link rel="stylesheet"
          href="~/Domio.Web.styles.css"
          asp-append-version="true" />
</head>
<body>
    <header class="domio-header">
        <nav class="navbar navbar-expand-lg">
            <div class="container-fluid px-4">
                <a class="navbar-brand domio-brand"
                   asp-controller="Home"
                   asp-action="Index">
                    <img src="~/images/domio-logo.png"
                         alt="Domio"
                         class="domio-brand-logo" />
                    <span class="domio-brand-text">
                        <span class="domio-brand-title">Domio</span>
                        <span class="domio-brand-subtitle">domowe centrum zarządzania</span>
                    </span>
                </a>

                <div class="ms-auto d-flex align-items-center gap-3">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <div class="domio-user d-none d-sm-block">
                            <div class="domio-user-name">
                                @User.Identity.Name
                            </div>
                            <div class="domio-user-role">
                                @User.FindFirst(DomioClaimTypes.RoleName)?.Value
                            </div>
                        </div>

                        @if (canViewOwnProfile)
                        {
                            <a asp-controller="Profiles"
                               asp-action="My"
                               class="btn btn-outline-primary btn-sm">
                                Mój profil
                            </a>
                        }

                        <form asp-controller="Account"
                              asp-action="Logout"
                              method="post">
                            <button type="submit"
                                    class="btn btn-outline-secondary btn-sm">
                                Wyloguj
                            </button>
                        </form>
                    }
                    else
                    {
                        <a asp-controller="Account"
                           asp-action="Login"
                           class="btn btn-outline-primary btn-sm">
                            Logowanie
                        </a>
                    }
                </div>
            </div>
        </nav>
    </header>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="domio-app-shell">
            <aside class="domio-sidebar">
                <nav class="domio-side-nav">
                    <a asp-controller="Home"
                       asp-action="Index"
                       class="domio-side-link">
                        <span class="domio-side-icon">S</span>
                        <span>Start</span>
                    </a>

                    @if (canViewUsers)
                    {
                        <a asp-controller="Users"
                           asp-action="Index"
                           class="domio-side-link">
                            <span class="domio-side-icon">U</span>
                            <span>Użytkownicy</span>
                        </a>
                    }

                    @if (canViewRoles)
                    {
                        <a asp-controller="Roles"
                           asp-action="Index"
                           class="domio-side-link">
                            <span class="domio-side-icon">R</span>
                            <span>Role i uprawnienia</span>
                        </a>
                    }

                    <div class="domio-side-section">Moduły</div>

                    @if (canViewPersonalFinance)
                    {
                        <a asp-controller="PersonalFinance"
                           asp-action="Index"
                           class="domio-side-link">
                            <span class="domio-side-icon">F</span>
                            <span>Finanse osobiste</span>
                        </a>
                    }

                    @if (canViewHouseholdFinance)
                    {
                        <a asp-controller="HouseholdFinance"
                           asp-action="Index"
                           class="domio-side-link">
                            <span class="domio-side-icon">D</span>
                            <span>Finanse domu</span>
                        </a>
                    }
                    else
                    {
                        <span class="domio-side-link is-disabled">
                            <span class="domio-side-icon">D</span>
                            <span>Finanse domu</span>
                        </span>
                    }

                    <span class="domio-side-link is-disabled">
                        <span class="domio-side-icon">N</span>
                        <span>Najem i media</span>
                    </span>
                </nav>
            </aside>

            <main role="main"
                  class="domio-main domio-main-with-sidebar">
                @RenderBody()
            </main>
        </div>
    }
    else
    {
        <main role="main" class="domio-main">
            @RenderBody()
        </main>
    }

    <footer class="domio-footer">
        <div class="container-fluid px-4 d-flex flex-column flex-md-row justify-content-between gap-2">
            <span>Domio · domowe centrum zarządzania</span>
            <span>M04.6 · finanse domu — faktury i płatności częściowe</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js"
            asp-append-version="true"></script>
    @await RenderSectionAsync(
        "Scripts",
        required: false)
</body>
</html>
