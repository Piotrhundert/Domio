@model Domio.Web.Models.Account.LoginViewModel
@{
    ViewData["Title"] = "Logowanie";
    var hasExistingUsers =
        ViewData["HasExistingUsers"] as bool? ?? false;
}

<div class="auth-shell auth-shell-modern">
    <div class="auth-background-orb auth-orb-left"></div>
    <div class="auth-background-orb auth-orb-right"></div>

    <div class="auth-layout">
        <section class="auth-showcase">
            <div class="auth-showcase-logo-wrap">
                <img src="~/images/domio-logo.png"
                     alt="Logo Domio"
                     class="auth-showcase-logo" />
            </div>

            <div class="auth-showcase-copy">
                <div class="auth-kicker">DOMIO</div>
                <h1>Witaj ponownie</h1>
                <p>
                    Zaloguj się, aby zarządzać domem, finansami osobistymi,
                    rachunkami i rozliczeniami w jednym miejscu.
                </p>
            </div>

            <div class="auth-feature-list">
                <div class="auth-feature-item">
                    <span class="auth-feature-icon">✓</span>
                    <div>
                        <strong>Jedno centrum domu</strong>
                        <div>Finanse, najem, media i codzienne rozliczenia.</div>
                    </div>
                </div>
                <div class="auth-feature-item">
                    <span class="auth-feature-icon">✓</span>
                    <div>
                        <strong>Bezpieczne logowanie</strong>
                        <div>Hasła są haszowane, a konto blokuje się po kilku błędnych próbach.</div>
                    </div>
                </div>
                <div class="auth-feature-item">
                    <span class="auth-feature-icon">✓</span>
                    <div>
                        <strong>Role i dostęp</strong>
                        <div>Każdy użytkownik widzi tylko te obszary, do których ma uprawnienia.</div>
                    </div>
                </div>
            </div>
        </section>

        <section class="auth-card auth-card-modern">
            <div class="auth-heading">
                <h2>Zaloguj się</h2>
                <p>Wpisz login i hasło, aby przejść do aplikacji.</p>
            </div>

            @if (TempData["AccountMessage"] is string message)
            {
                <div class="alert alert-success" role="alert">
                    @message
                </div>
            }

            <form asp-action="Login" method="post" class="auth-form">
                <input asp-for="ReturnUrl" type="hidden" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger small mb-3"></div>

                <div class="mb-3">
                    <label asp-for="LoginName" class="form-label"></label>
                    <input asp-for="LoginName"
                           class="form-control form-control-lg"
                           autocomplete="username"
                           placeholder="np. piotr"
                           autofocus />
                    <span asp-validation-for="LoginName"
                          class="text-danger small"></span>
                </div>

                <div class="mb-2">
                    <div class="d-flex justify-content-between align-items-center gap-2">
                        <label asp-for="Password" class="form-label mb-0"></label>

                        @if (hasExistingUsers)
                        {
                            <a asp-controller="Account"
                               asp-action="ForgotPassword"
                               class="auth-forgot-link">
                                Nie pamiętasz hasła?
                            </a>
                        }
                    </div>

                    <input asp-for="Password"
                           class="form-control form-control-lg mt-2"
                           autocomplete="current-password"
                           placeholder="Wpisz hasło" />
                    <span asp-validation-for="Password"
                          class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-between align-items-center my-4 flex-wrap gap-2">
                    <div class="form-check">
                        <input asp-for="RememberMe"
                               class="form-check-input" />
                        <label asp-for="RememberMe"
                               class="form-check-label"></label>
                    </div>
                    <span class="auth-meta-note">Sesja do 8 godzin</span>
                </div>

                <button type="submit"
                        class="btn btn-primary btn-lg w-100 auth-submit-btn">
                    Zaloguj się
                </button>
            </form>

            <div class="auth-security-note">
                <span class="auth-security-dot"></span>
                Sesja jest chroniona ciasteczkiem HTTP-only. Po 5 błędnych próbach konto zostanie czasowo zablokowane.
            </div>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
