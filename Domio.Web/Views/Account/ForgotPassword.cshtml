@{
    ViewData["Title"] = "Nie pamiętam hasła";
}

<div class="auth-shell auth-shell-modern">
    <div class="auth-background-orb auth-orb-left"></div>
    <div class="auth-background-orb auth-orb-right"></div>

    <div class="auth-card auth-card-modern auth-recovery-card">
        <div class="text-center mb-4">
            <img src="~/images/domio-logo.png"
                 alt="Logo Domio"
                 class="auth-inline-logo mb-3" />
            <div class="auth-kicker">ODZYSKIWANIE DOSTĘPU</div>
            <h1 class="h3 mb-2">Nie pamiętasz hasła?</h1>
            <p class="text-secondary mb-0">
                Automatyczne resetowanie hasła przez e-mail zostanie podłączone
                do modułu powiadomień Domio.
            </p>
        </div>

        <div class="auth-recovery-info">
            <strong>Na obecnym etapie:</strong>
            <p class="mb-0 mt-1">
                skontaktuj się z administratorem Domio, który w panelu użytkowników
                będzie mógł nadać nowe hasło. Ze względów bezpieczeństwa ekran
                logowania nie ujawnia, czy konkretny login istnieje.
            </p>
        </div>

        <a asp-controller="Account"
           asp-action="Login"
           class="btn btn-primary btn-lg w-100 auth-submit-btn mt-4">
            Wróć do logowania
        </a>
    </div>
</div>
