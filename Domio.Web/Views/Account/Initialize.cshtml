@model Domio.Web.Models.Account.InitializeAdministratorViewModel
@{
    ViewData["Title"] = "Pierwsze uruchomienie";
}

<div class="auth-shell auth-shell-modern">
    <div class="auth-background-orb auth-orb-left"></div>
    <div class="auth-background-orb auth-orb-right"></div>

    <div class="auth-layout">
        <section class="auth-showcase">
            <div class="auth-showcase-logo-wrap">
                <img src="~/images/domio-logo.png"
                     alt="Logo Domio"
                     class="auth-showcase-logo" />
            </div>

            <div class="auth-showcase-copy">
                <div class="auth-kicker">PIERWSZE URUCHOMIENIE</div>
                <h1>Skonfiguruj pierwsze konto</h1>
                <p>
                    W tym kroku utworzysz pierwszego administratora Domio,
                    który będzie zarządzać użytkownikami, finansami i ustawieniami systemu.
                </p>
            </div>

            <div class="auth-feature-list">
                <div class="auth-feature-item">
                    <span class="auth-feature-icon">1</span>
                    <div>
                        <strong>Utwórz konto administratora</strong>
                        <div>Ten krok wykonujesz tylko raz w środowisku deweloperskim.</div>
                    </div>
                </div>
                <div class="auth-feature-item">
                    <span class="auth-feature-icon">2</span>
                    <div>
                        <strong>Ustaw bezpieczne hasło</strong>
                        <div>Minimum 10 znaków, mała i wielka litera oraz cyfra.</div>
                    </div>
                </div>
                <div class="auth-feature-item">
                    <span class="auth-feature-icon">3</span>
                    <div>
                        <strong>Zaloguj się i pracuj dalej</strong>
                        <div>Po zapisaniu konta przejdziesz bezpośrednio do logowania.</div>
                    </div>
                </div>
            </div>
        </section>

        <section class="auth-card auth-card-modern auth-card-wide">
            <div class="auth-heading">
                <h2>Utwórz administratora</h2>
                <p>Pierwsze konto otrzyma rolę <strong>Administrator</strong>.</p>
            </div>

            <form asp-action="Initialize"
                  method="post"
                  class="auth-form">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger small mb-3"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="FirstName"
                               class="form-label"></label>
                        <input asp-for="FirstName"
                               class="form-control"
                               autocomplete="given-name"
                               placeholder="Imię" />
                        <span asp-validation-for="FirstName"
                              class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="LastName"
                               class="form-label"></label>
                        <input asp-for="LastName"
                               class="form-control"
                               autocomplete="family-name"
                               placeholder="Nazwisko" />
                        <span asp-validation-for="LastName"
                              class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="LoginName"
                               class="form-label"></label>
                        <input asp-for="LoginName"
                               class="form-control"
                               autocomplete="username"
                               placeholder="Login administratora" />
                        <span asp-validation-for="LoginName"
                              class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Password"
                               class="form-label"></label>
                        <input asp-for="Password"
                               class="form-control"
                               autocomplete="new-password"
                               placeholder="Ustaw hasło" />
                        <span asp-validation-for="Password"
                              class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="ConfirmPassword"
                               class="form-label"></label>
                        <input asp-for="ConfirmPassword"
                               class="form-control"
                               autocomplete="new-password"
                               placeholder="Powtórz hasło" />
                        <span asp-validation-for="ConfirmPassword"
                              class="text-danger small"></span>
                    </div>
                </div>

                <div class="password-rules">
                    Hasło: minimum 10 znaków, co najmniej jedna mała litera,
                    jedna wielka litera i jedna cyfra.
                </div>

                <button type="submit"
                        class="btn btn-primary btn-lg w-100 mt-4 auth-submit-btn">
                    Utwórz konto administratora
                </button>
            </form>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
