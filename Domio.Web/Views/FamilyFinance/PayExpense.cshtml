@model Domio.Web.Models.FamilyFinance.PayFamilyExpenseViewModel
@{
    ViewData["Title"] = "Opłać koszt rodzinny";
}

<div class="family-finance-page">
    <div class="family-finance-form-header">
        <div>
            <div class="family-finance-kicker">M04.8.3 · PŁATNOŚĆ KOSZTU</div>
            <h1>Opłać planowany koszt</h1>
            <p>
                Rodzina: <strong>@Model.FamilyGroupName</strong>. Płatność utworzy rzeczywistą
                operację na wybranym koncie i automatycznie zaliczy ją do wykonania budżetu rodzinnego.
            </p>
        </div>
        <a asp-action="Index"
           asp-route-familyGroupId="@Model.FamilyGroupId"
           asp-route-year="@Model.Year"
           asp-route-month="@Model.Month"
           class="btn btn-outline-secondary">Wróć</a>
    </div>

    <form asp-action="PayExpense" method="post" class="family-finance-form-card">
        <input type="hidden" asp-for="FamilyGroupId" />
        <input type="hidden" asp-for="OccurrenceId" />
        <input type="hidden" asp-for="Year" />
        <input type="hidden" asp-for="Month" />

        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="family-finance-form-note mb-3">
            <strong>@Model.RuleName</strong><br />
            Kategoria: @Model.CategoryNamePl · termin planu: @Model.PlannedDateUtc.ToString("dd.MM.yyyy")
            @if (!string.IsNullOrWhiteSpace(Model.BeneficiaryDisplayName))
            {
                <text> · beneficjent: @Model.BeneficiaryDisplayName</text>
            }
        </div>

        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Kwota do zapłaty</label>
                <div class="input-group">
                    <input class="form-control" value="@Model.Amount.ToString("N2")" readonly />
                    <span class="input-group-text">zł</span>
                </div>
            </div>
            <div class="col-md-6">
                <label asp-for="PaidAtUtc" class="form-label"></label>
                <input asp-for="PaidAtUtc" type="date" class="form-control" />
                <span asp-validation-for="PaidAtUtc" class="text-danger"></span>
            </div>
        </div>

        <div class="mb-3 mt-3">
            <label asp-for="SelectedAccountKey" class="form-label"></label>
            @if (Model.Accounts.Count > 0)
            {
                <select asp-for="SelectedAccountKey" asp-items="Model.Accounts" class="form-select">
                    <option value="">— wybierz konto —</option>
                </select>
                <span asp-validation-for="SelectedAccountKey" class="text-danger"></span>
            }
            else
            {
                <div class="alert alert-warning mb-0">
                    Nie masz dostępnego konta PLN, z którego można opłacić ten koszt.
                    Konto osobiste wymaga prawa do własnych finansów, a konto domowe także prawa do zarządzania finansami domu i rodziny.
                </div>
            }
        </div>

        <div class="family-finance-form-note">
            <strong>Konto osobiste:</strong> powstanie prywatny wydatek i tylko ta konkretna płatność zostanie jawnie powiązana z rodziną.<br />
            <strong>Konto domowe:</strong> powstanie wydatek na koncie domu. Domio nie tworzy trzeciego salda rodzinnego i nie księguje tej kwoty drugi raz.
        </div>

        <div class="family-finance-form-actions">
            @if (Model.Accounts.Count == 0)
            {
                <button type="submit" class="btn btn-primary" disabled>
                    Opłać @Model.Amount.ToString("N2") zł
                </button>
            }
            else
            {
                <button type="submit" class="btn btn-primary">
                    Opłać @Model.Amount.ToString("N2") zł
                </button>
            }
            <a asp-action="Index"
               asp-route-familyGroupId="@Model.FamilyGroupId"
               asp-route-year="@Model.Year"
               asp-route-month="@Model.Month"
               class="btn btn-outline-secondary">Anuluj</a>
        </div>
    </form>
</div>
