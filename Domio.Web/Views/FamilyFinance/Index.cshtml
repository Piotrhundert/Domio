@using Domio.Application.Authorization
@using Domio.Domain.FamilyFinance
@model Domio.Web.Models.FamilyFinance.FamilyFinanceIndexViewModel
@{
    ViewData["Title"] = "Finanse rodzinne";

    var overview = Model.Overview;
    var canManage =
        User.HasClaim(
            DomioClaimTypes.Permission,
            FamilyFinancePermissions.Manage);
    var canShare =
        User.HasClaim(
            DomioClaimTypes.Permission,
            FamilyFinancePermissions.ShareOwn);

    var currentPeriod = new DateTime(overview.Year, overview.Month, 1);
    var previousPeriod = currentPeriod.AddMonths(-1);
    var nextPeriod = currentPeriod.AddMonths(1);
    var hasChildren =
        overview.Members.Any(x =>
            x.FamilyRoleCode == FamilyRoles.Child);
}

<div class="family-finance-page">
    <div class="family-finance-header family-finance-header-clean">
        <div>
            <div class="family-finance-kicker">M04.8.7 · FINANSE RODZINNE</div>
            <h1>Finanse rodzinne</h1>
            <p>
                Wspólny plan i wykonanie rodziny, przychody dzieci, składki dla domu
                oraz rzeczywiste wspólne konto rodziny.
            </p>
        </div>
    </div>

    @if (overview.HasFamily)
    {
        <nav class="family-finance-folder-tabs"
             aria-label="Sekcje finansów rodzinnych">
            <a asp-action="Index"
               asp-route-familyGroupId="@overview.SelectedFamilyGroupId"
               asp-route-year="@overview.Year"
               asp-route-month="@overview.Month"
               asp-route-tab="overview"
               class="family-finance-folder-tab @(Model.SelectedTab == "overview" ? "is-active" : "")">
                Przegląd
            </a>
            <a asp-action="Index"
               asp-route-familyGroupId="@overview.SelectedFamilyGroupId"
               asp-route-year="@overview.Year"
               asp-route-month="@overview.Month"
               asp-route-tab="members"
               class="family-finance-folder-tab @(Model.SelectedTab == "members" ? "is-active" : "")">
                Członkowie
            </a>
            @if (hasChildren)
            {
                <a asp-action="Index"
                   asp-route-familyGroupId="@overview.SelectedFamilyGroupId"
                   asp-route-year="@overview.Year"
                   asp-route-month="@overview.Month"
                   asp-route-tab="children"
                   class="family-finance-folder-tab @(Model.SelectedTab == "children" ? "is-active" : "")">
                    Dzieci
                </a>
                <a asp-action="Index"
                   asp-route-familyGroupId="@overview.SelectedFamilyGroupId"
                   asp-route-year="@overview.Year"
                   asp-route-month="@overview.Month"
                   asp-route-tab="child-contributions"
                   class="family-finance-folder-tab @(Model.SelectedTab == "child-contributions" ? "is-active" : "")">
                    Składki dzieci
                </a>
            }
            <a asp-action="Index"
               asp-route-familyGroupId="@overview.SelectedFamilyGroupId"
               asp-route-year="@overview.Year"
               asp-route-month="@overview.Month"
               asp-route-tab="expenses"
               class="family-finance-folder-tab @(Model.SelectedTab == "expenses" ? "is-active" : "")">
                Koszty
            </a>
            <a asp-action="Index"
               asp-route-familyGroupId="@overview.SelectedFamilyGroupId"
               asp-route-year="@overview.Year"
               asp-route-month="@overview.Month"
               asp-route-tab="shared"
               class="family-finance-folder-tab @(Model.SelectedTab == "shared" ? "is-active" : "")">
                Wspólne konto
            </a>
        </nav>
    }

    @if (TempData["FamilyFinanceMessage"] is string message)
    {
        <div class="alert alert-success mb-4" role="alert">@message</div>
    }

    @if (TempData["FamilyFinanceError"] is string error)
    {
        <div class="alert alert-danger mb-4" role="alert">@error</div>
    }

    @if (!overview.HasHousehold)
    {
        <div class="family-finance-empty">
            <div class="family-finance-empty-icon">R</div>
            <h2>Najpierw skonfiguruj gospodarstwo</h2>
            <p>
                Grupa rodzinna zawsze należy do konkretnego gospodarstwa.
                Utwórz konto domu w module Finanse domu i wróć tutaj.
            </p>
            <a asp-controller="HouseholdFinance"
               asp-action="Index"
               class="btn btn-primary">
                Przejdź do finansów domu
            </a>
        </div>
    }
    else if (!overview.HasFamily)
    {
        <div class="family-finance-empty">
            <div class="family-finance-empty-icon">R</div>
            <h2>Nie masz jeszcze grupy rodzinnej</h2>
            <p>
                Utworzenie rodziny doda Cię jako osobę dorosłą. Domyślnie
                żadne prywatne saldo, historia ani przychody nie są udostępniane.
            </p>

            @if (canManage)
            {
                <a asp-action="CreateGroup"
                   class="btn btn-primary">
                    Utwórz pierwszą rodzinę
                </a>
            }
        </div>
    }
    else
    {
        @if (overview.Groups.Count > 1)
        {
            <div class="family-finance-group-tabs">
                @foreach (var group in overview.Groups)
                {
                    <a asp-action="Index"
                       asp-route-familyGroupId="@group.FamilyGroupId"
                       asp-route-year="@overview.Year"
                       asp-route-month="@overview.Month"
                       asp-route-tab="@Model.SelectedTab"
                       class="family-finance-group-tab @(group.FamilyGroupId == overview.SelectedFamilyGroupId ? "is-active" : "")">
                        <strong>@group.Name</strong>
                        <span>@group.CurrentMemberRoleNamePl</span>
                    </a>
                }
            </div>
        }

        @if (Model.SelectedTab == "overview" && canManage && overview.HasHousehold)
        {
            <div class="d-flex justify-content-end">
                <a asp-action="CreateGroup"
                   class="family-finance-section-link">
                    + Nowa rodzina
                </a>
            </div>
        }

        <div id="family-overview" class="family-finance-family-card @(Model.SelectedTab == "overview" ? "" : "d-none")">
            <div>
                <span>Rodzina</span>
                <strong>@overview.SelectedFamilyGroupName</strong>
            </div>
            <div>
                <span>Gospodarstwo</span>
                <strong>@overview.HouseholdName</strong>
            </div>
            <div>
                <span>Twoja rola</span>
                <strong>@FamilyRoles.GetNamePl(overview.CurrentMemberRoleCode ?? "")</strong>
            </div>
            <div>
                <span>Członkowie</span>
                <strong>@overview.Members.Count</strong>
            </div>
        </div>

        <div class="family-finance-period-bar">
            <a asp-action="Index"
               asp-route-familyGroupId="@overview.SelectedFamilyGroupId"
               asp-route-year="@previousPeriod.Year"
               asp-route-month="@previousPeriod.Month"
               asp-route-tab="@Model.SelectedTab"
               class="btn btn-sm btn-outline-secondary">
                ← Poprzedni
            </a>

            <strong>@currentPeriod.ToString("MMMM yyyy")</strong>

            <a asp-action="Index"
               asp-route-familyGroupId="@overview.SelectedFamilyGroupId"
               asp-route-year="@nextPeriod.Year"
               asp-route-month="@nextPeriod.Month"
               asp-route-tab="@Model.SelectedTab"
               class="btn btn-sm btn-outline-secondary">
                Następny →
            </a>
        </div>

        <div class="family-finance-summary-grid @(Model.SelectedTab == "overview" ? "" : "d-none")">
            <article class="family-finance-summary-card">
                <span>Planowane przychody</span>
                <strong>@overview.PlannedIncomeTotal.ToString("N2") zł</strong>
                <small>Udostępnione plany dorosłych oraz przychody przypisane dzieciom.</small>
            </article>

            <article class="family-finance-summary-card">
                <span>Rzeczywiste przychody</span>
                <strong>@overview.ActualIncomeTotal.ToString("N2") zł</strong>
                <small>Udostępnione przychody dorosłych oraz potwierdzone wpływy przypisane dzieciom.</small>
            </article>

            <article class="family-finance-summary-card">
                <span>Planowane wydatki</span>
                <strong>@((Model.Budget?.PlannedExpenseTotal ?? 0m).ToString("N2")) zł</strong>
                <small>Rodzinne reguły i jawnie udostępnione prywatne reguły cykliczne.</small>
            </article>

            <article class="family-finance-summary-card">
                <span>Rzeczywiste wydatki</span>
                <strong>@((Model.Budget?.ActualExpenseTotal ?? 0m).ToString("N2")) zł</strong>
                <small>Tylko źródła jawnie powiązane przez FamilyBudgetLink.</small>
            </article>

            <article class="family-finance-summary-card family-finance-result-card">
                <span>Wynik rzeczywisty miesiąca</span>
                <strong>@((overview.ActualIncomeTotal - (Model.Budget?.ActualExpenseTotal ?? 0m)).ToString("N2")) zł</strong>
                <small>Rzeczywiste przychody minus rzeczywiste wydatki rodzinne.</small>
            </article>
        </div>


        <section id="family-shared-accounts" class="family-finance-section @(Model.SelectedTab == "shared" ? "" : "d-none")">
            <div class="family-finance-section-heading">
                <div>
                    <div class="family-finance-section-number">KONTO</div>
                    <h2>Wspólne konta rodziny</h2>
                    <p>
                        To rzeczywiste rachunki z jednym saldem i jedną historią operacji.
                        Właściciel i współwłaściciel widzą ten sam rachunek również w Finansach osobistych.
                    </p>
                </div>

                @if (canManage)
                {
                    <a asp-action="CreateSharedAccount"
                       asp-route-familyGroupId="@overview.SelectedFamilyGroupId"
                       class="family-finance-section-link">
                        + Utwórz konto
                    </a>
                }
            </div>

            @if (overview.SharedAccounts.Count == 0)
            {
                <div class="family-finance-empty family-finance-empty-compact">
                    Rodzina nie ma jeszcze wspólnego konta.
                </div>
            }
            else
            {
                <div class="finance-account-grid">
                    @foreach (var account in overview.SharedAccounts)
                    {
                        var canOperate =
                            account.CurrentPersonRoleCode == FamilySharedAccountRoles.Owner ||
                            account.CurrentPersonRoleCode == FamilySharedAccountRoles.CoOwner;

                        <article class="finance-account-card">
                            <div class="finance-account-top">
                                <div>
                                    <span class="finance-account-type">
                                        Wspólne · @account.AccountTypeNamePl
                                    </span>
                                    <h3>@account.AccountName</h3>
                                </div>

                                @if (account.IsActive)
                                {
                                    <span class="finance-status-active">Aktywne</span>
                                }
                                else
                                {
                                    <span class="finance-status-inactive">Nieaktywne</span>
                                }
                            </div>

                            <div class="finance-balance">
                                <span>Saldo</span>
                                <strong>
                                    @account.Balance.ToString("N2")
                                    <small>@account.CurrencyCode</small>
                                </strong>
                            </div>

                            <div class="finance-recurring-rule-meta">
                                <span>
                                    Właściciel: <strong>@account.OwnerDisplayName</strong>
                                </span>
                                <span>
                                    Współwłaściciel: <strong>@account.CoOwnerDisplayName</strong>
                                </span>
                                <span>
                                    Twój dostęp: <strong>@account.CurrentPersonRoleNamePl</strong>
                                </span>
                            </div>

                            @if (account.IsActive && canOperate)
                            {
                                <div class="finance-account-actions">
                                    <a asp-action="SharedAccountOperation"
                                       asp-route-sharedAccountId="@account.SharedAccountId"
                                       class="finance-account-action">
                                        Dodaj przychód lub wydatek →
                                    </a>
                                </div>
                            }
                        </article>
                    }
                </div>
            }
        </section>

        <section id="family-members" class="family-finance-section @(Model.SelectedTab == "members" ? "" : "d-none")">
            <div class="family-finance-section-heading">
                <div>
                    <div class="family-finance-section-number">01</div>
                    <h2>Członkowie i przychody</h2>
                    <p>
                        Brak udostępnienia dorosłego nie jest traktowany jako 0 zł.
                        Przychody przypisane dziecku są częścią planu rodziny i nie wymagają konta dziecka.
                    </p>
                </div>

                <div class="d-flex flex-wrap gap-2 justify-content-end">
                    @if (canShare && overview.OwnSharing is not null)
                    {
                        <a asp-action="Sharing"
                           asp-route-familyGroupId="@overview.SelectedFamilyGroupId"
                           class="family-finance-section-link">
                            Moje udostępnianie
                        </a>
                    }
                    @if (canManage)
                    {
                        <a asp-action="AddMember"
                           asp-route-familyGroupId="@overview.SelectedFamilyGroupId"
                           class="family-finance-section-link">
                            + Dodaj członka
                        </a>
                    }
                </div>
            </div>

            <div class="table-responsive family-finance-table-wrap">
                <table class="table family-finance-table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Osoba</th>
                            <th>Rola</th>
                            <th>Planowane przychody</th>
                            <th>Rzeczywiste przychody</th>
                            <th>Plan wydatków</th>
                            <th>Wydatki rzeczywiste</th>
                            <th>Udostępnianie</th>
                            @if (canManage)
                            {
                                <th class="text-end">Akcja</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var member in overview.Members)
                    {
                        var isSelf = member.PersonId == overview.CurrentPersonId;
                        var personExpenses = Model.Budget?.PersonExpenses
                            .FirstOrDefault(x => x.PersonId == member.PersonId);

                        <tr>
                            <td>
                                <strong>@member.DisplayName</strong>
                                @if (isSelf)
                                {
                                    <span class="family-finance-self">Ty</span>
                                }
                            </td>
                            <td>
                                <span class="family-finance-role @member.FamilyRoleCode.ToLowerInvariant()">
                                    @member.FamilyRoleNamePl
                                </span>
                            </td>
                            <td>
                                @if (member.PlannedIncome.HasValue)
                                {
                                    <strong>@member.PlannedIncome.Value.ToString("N2") zł</strong>
                                    @if (member.FamilyRoleCode == FamilyRoles.Child)
                                    {
                                        <small class="d-block text-muted">plan przypisany do dziecka</small>
                                    }
                                }
                                else
                                {
                                    <span class="family-finance-private">Prywatne</span>
                                }
                            </td>
                            <td>
                                @if (member.FamilyRoleCode == FamilyRoles.Child)
                                {
                                    <strong>@((member.ActualIncome ?? 0m).ToString("N2")) zł</strong>
                                    <small class="d-block text-muted">potwierdzone wpływy</small>
                                }
                                else if (member.ActualIncome.HasValue)
                                {
                                    <strong>@member.ActualIncome.Value.ToString("N2") zł</strong>
                                }
                                else
                                {
                                    <span class="family-finance-private">Prywatne</span>
                                }
                            </td>
                            <td>
                                @if (member.FamilyRoleCode == FamilyRoles.Child)
                                {
                                    <span class="family-finance-private">Nie dotyczy</span>
                                }
                                else if (member.ShareRecurringRules)
                                {
                                    <strong>@((personExpenses?.PlannedAmount ?? 0m).ToString("N2")) zł</strong>
                                }
                                else
                                {
                                    <span class="family-finance-private">Prywatne</span>
                                }
                            </td>
                            <td>
                                @if (member.FamilyRoleCode == FamilyRoles.Child)
                                {
                                    <span class="family-finance-private">Nie dotyczy</span>
                                }
                                else if (member.ShareFamilyExpenses)
                                {
                                    <strong>@((personExpenses?.ActualAmount ?? 0m).ToString("N2")) zł</strong>
                                }
                                else
                                {
                                    <span class="family-finance-private">Prywatne</span>
                                }
                            </td>
                            <td>
                                @if (member.FamilyRoleCode == FamilyRoles.Child)
                                {
                                    <span class="family-finance-sharing-pill neutral">bez konta</span>
                                }
                                else
                                {
                                    <div class="family-finance-sharing-list">
                                        <span class="family-finance-sharing-pill @(member.SharePlannedIncome ? "on" : "off")">
                                            plan @(member.SharePlannedIncome ? "✓" : "—")
                                        </span>
                                        <span class="family-finance-sharing-pill @(member.ShareActualIncome ? "on" : "off")">
                                            przychód @(member.ShareActualIncome ? "✓" : "—")
                                        </span>
                                        <span class="family-finance-sharing-pill @(member.ShareFamilyExpenses ? "on" : "off")">
                                            wydatki @(member.ShareFamilyExpenses ? "✓" : "—")
                                        </span>
                                        <span class="family-finance-sharing-pill @(member.ShareRecurringRules ? "on" : "off")">
                                            cykliczne @(member.ShareRecurringRules ? "✓" : "—")
                                        </span>
                                    </div>
                                }
                            </td>

                            @if (canManage)
                            {
                                <td class="text-end">
                                    @if (member.FamilyRoleCode == FamilyRoles.Child)
                                    {
                                        <a asp-action="CreateChildIncome"
                                           asp-route-familyGroupId="@overview.SelectedFamilyGroupId"
                                           asp-route-personId="@member.PersonId"
                                           class="btn btn-sm btn-primary me-1">
                                            + Przychód
                                        </a>
                                    }
                                    @if (!isSelf)
                                    {
                                        <form asp-action="EndMember"
                                              method="post"
                                              class="d-inline"
                                              onsubmit="return confirm('Zakończyć członkostwo tej osoby? Historia pozostanie zachowana.');">
                                            <input type="hidden"
                                                   name="membershipId"
                                                   value="@member.MembershipId" />
                                            <input type="hidden"
                                                   name="familyGroupId"
                                                   value="@overview.SelectedFamilyGroupId" />
                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-secondary">
                                                Zakończ członkostwo
                                            </button>
                                        </form>
                                    }
                                </td>
                            }
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </section>

        @if (overview.ChildIncomeRules.Count > 0)
        {
            <section id="family-children" class="family-finance-section @(Model.SelectedTab == "children" ? "" : "d-none")">
                <div class="family-finance-section-heading">
                    <div>
                        <h2>Przychody przypisane do dzieci</h2>
                        <p>
                            To plan budżetu rodzinnego. Przypisanie świadczenia do dziecka
                            nie oznacza, że dziecko musi mieć własny rachunek bankowy.
                        </p>
                    </div>
                </div>

                <div class="table-responsive family-finance-table-wrap">
                    <table class="table family-finance-table align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Dziecko</th>
                                <th>Przychód</th>
                                <th>Kwota</th>
                                <th>Częstotliwość</th>
                                <th>Status miesiąca</th>
                                <th>Status reguły</th>
                                @if (canManage)
                                {
                                    <th class="text-end">Akcja</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var income in overview.ChildIncomeRules)
                        {
                            <tr>
                                <td><strong>@income.BeneficiaryDisplayName</strong></td>
                                <td>
                                    @income.Name
                                    @if (income.Name != income.IncomeKindNamePl)
                                    {
                                        <small class="d-block text-muted">@income.IncomeKindNamePl</small>
                                    }
                                </td>
                                <td><strong>@income.PlannedAmount.ToString("N2") zł</strong></td>
                                <td>@income.FrequencyNamePl · dzień @income.DueDay</td>
                                <td>
                                    @if (!income.AppliesInSelectedMonth)
                                    {
                                        <span class="family-finance-sharing-pill neutral">Nie przypada</span>
                                    }
                                    else if (income.IsReceived)
                                    {
                                        <span class="family-finance-sharing-pill on">Potwierdzono</span>
                                        @if (income.ReceivedAmount.HasValue && income.ReceivedAtUtc.HasValue)
                                        {
                                            <small class="d-block text-muted mt-1">
                                                @income.ReceivedAmount.Value.ToString("N2") zł · @income.ReceivedAtUtc.Value.ToString("dd.MM.yyyy")
                                            </small>
                                        }
                                    }
                                    else
                                    {
                                        <span class="family-finance-sharing-pill neutral">Do potwierdzenia</span>
                                        @if (income.PlannedDateUtc.HasValue)
                                        {
                                            <small class="d-block text-muted mt-1">
                                                plan @income.PlannedDateUtc.Value.ToString("dd.MM.yyyy")
                                            </small>
                                        }
                                    }
                                </td>
                                <td>
                                    <span class="family-finance-sharing-pill @(income.IsActive ? "on" : "neutral")">
                                        @(income.IsActive ? "Aktywny" : "Zakończony")
                                    </span>
                                </td>
                                @if (canManage)
                                {
                                    <td class="text-end">
                                        @if (income.CanConfirmReceipt)
                                        {
                                            <a asp-action="ConfirmChildIncome"
                                               asp-route-familyGroupId="@overview.SelectedFamilyGroupId"
                                               asp-route-ruleId="@income.RuleId"
                                               asp-route-year="@overview.Year"
                                               asp-route-month="@overview.Month"
                                               class="btn btn-sm btn-primary me-1">
                                                Potwierdź wpływ
                                            </a>
                                        }
                                        @if (income.IsActive)
                                        {
                                            <form asp-action="DeactivateChildIncome" method="post" class="d-inline">
                                                <input type="hidden" name="ruleId" value="@income.RuleId" />
                                                <input type="hidden" name="familyGroupId" value="@overview.SelectedFamilyGroupId" />
                                                <input type="hidden" name="year" value="@overview.Year" />
                                                <input type="hidden" name="month" value="@overview.Month" />
                                                <button type="submit" class="btn btn-sm btn-outline-secondary">Zakończ</button>
                                            </form>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </section>
        }


        @if (hasChildren && overview.ChildIncomeRules.Count == 0)
        {
            <section class="family-finance-section @(Model.SelectedTab == "children" ? "" : "d-none")">
                <div class="family-finance-section-heading">
                    <div>
                        <div class="family-finance-section-number">DZIECI</div>
                        <h2>Przychody dzieci</h2>
                        <p>
                            Dzieci są członkami rodziny, ale nie mają jeszcze przypisanych
                            planowanych przychodów.
                        </p>
                    </div>
                </div>
                <div class="family-finance-inline-empty">
                    Dodaj przychód dziecka z zakładki „Członkowie”.
                </div>
            </section>
        }

        @if (hasChildren)
        {
            <section id="family-child-contributions"
                     class="family-finance-section family-finance-child-contribution-section @(Model.SelectedTab == "child-contributions" ? "" : "d-none")">
                <div class="family-finance-section-heading">
                    <div>
                        <div class="family-finance-section-number">SKŁADKI DZIECI</div>
                        <h2>Składki dzieci dla domu</h2>
                        <p>
                            Składka dziecka pochodzi z modułu „Składki i domownicy”.
                            Możesz pokryć ją ze wspólnego konta rodziny albo ze środków
                            już znajdujących się na koncie domu.
                        </p>
                    </div>

                    @if (canManage)
                    {
                        <a asp-controller="HouseholdContributionAdmin"
                           asp-action="Index"
                           class="family-finance-section-link">
                            Zarządzaj regułami składek
                        </a>
                    }
                </div>

                @if (overview.ChildHouseholdContributions.Count == 0)
                {
                    <div class="family-finance-inline-empty">
                        Nie znaleziono żadnej reguły składki dla dziecka należącego do tej rodziny.
                        Regułę składki możesz ustawić w „Składki i domownicy”.
                    </div>
                }
                else
                {
                    <div class="table-responsive family-finance-table-wrap">
                        <table class="table family-finance-table align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Dziecko</th>
                                    <th>Miesiąc</th>
                                    <th>Termin</th>
                                    <th>Konto domu</th>
                                    <th>Składka</th>
                                    <th>Status</th>
                                    @if (canManage)
                                    {
                                        <th class="text-end">Akcja</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                            @foreach (var contribution in overview.ChildHouseholdContributions)
                            {
                                <tr>
                                    <td>
                                        <strong>@contribution.ChildDisplayName</strong>
                                        <small class="d-block text-muted">
                                            składka dla gospodarstwa
                                        </small>
                                    </td>
                                    <td>
                                        <strong>@contribution.PeriodKey</strong>
                                    </td>
                                    <td>
                                        @contribution.DueDateUtc.ToString("dd.MM.yyyy")
                                    </td>
                                    <td>
                                        @contribution.TargetHouseholdAccountName
                                    </td>
                                    <td>
                                        <strong>
                                            @contribution.Amount.ToString("N2")
                                            @contribution.CurrencyCode
                                        </strong>
                                        @if (contribution.PaidAmount > 0m &&
                                             contribution.OutstandingAmount > 0m)
                                        {
                                            <small class="d-block text-muted">
                                                pozostało @contribution.OutstandingAmount.ToString("N2")
                                                @contribution.CurrencyCode
                                            </small>
                                        }
                                    </td>
                                    <td>
                                        <span class="family-finance-sharing-pill @(contribution.OutstandingAmount <= 0m ? "on" : "neutral")">
                                            @contribution.StatusNamePl
                                        </span>
                                        @if (!string.IsNullOrWhiteSpace(contribution.AvailabilityNote))
                                        {
                                            <small class="d-block text-muted mt-1">
                                                @contribution.AvailabilityNote
                                            </small>
                                        }
                                    </td>
                                    @if (canManage)
                                    {
                                        <td class="text-end">
                                            @if (contribution.CanPay && contribution.ObligationId.HasValue)
                                            {
                                                <a asp-action="PayChildContribution"
                                                   asp-route-familyGroupId="@overview.SelectedFamilyGroupId"
                                                   asp-route-obligationId="@contribution.ObligationId.Value"
                                                   asp-route-year="@overview.Year"
                                                   asp-route-month="@overview.Month"
                                                   class="btn btn-sm btn-primary">
                                                    Przekaż do domu
                                                </a>
                                            }
                                            else if (contribution.OutstandingAmount <= 0m)
                                            {
                                                <span class="family-finance-complete-label">
                                                    Przekazano ✓
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">
                                                    Zaplanowana
                                                </span>
                                            }
                                        </td>
                                    }
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            </section>
        }

        @if (Model.Budget is not null && Model.SelectedTab == "expenses")
        {
            <section id="family-expenses" class="family-finance-section">
                <div class="family-finance-section-heading">
                    <div>
                        <div class="family-finance-section-number">02</div>
                        <h2>Planowane koszty i subskrypcje</h2>
                        <p>
                            Plan nie księguje pieniędzy. Generator tworzy najwyżej jedno
                            wystąpienie reguły na miesiąc.
                        </p>
                    </div>
                    @if (canManage)
                    {
                        <a asp-action="CreateExpense"
                           asp-route-familyGroupId="@overview.SelectedFamilyGroupId"
                           class="family-finance-section-link">+ Dodaj koszt</a>
                    }
                </div>

                @if (Model.Budget.FamilyRules.Count == 0)
                {
                    <div class="family-finance-inline-empty">
                        Nie ma jeszcze rodzinnych kosztów planowanych.
                    </div>
                }
                else
                {
                    <div class="table-responsive family-finance-table-wrap">
                        <table class="table family-finance-table align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Nazwa</th>
                                    <th>Kategoria</th>
                                    <th>Kwota</th>
                                    <th>Częstotliwość</th>
                                    <th>Beneficjent</th>
                                    <th>Status miesiąca</th>
                                    <th class="text-end">Akcja</th>
                                </tr>
                            </thead>
                            <tbody>
                            @foreach (var rule in Model.Budget.FamilyRules)
                            {
                                <tr>
                                    <td><strong>@rule.Name</strong></td>
                                    <td>@rule.CategoryNamePl</td>
                                    <td><strong>@rule.PlannedAmount.ToString("N2") zł</strong></td>
                                    <td>@rule.FrequencyNamePl · dzień @rule.DueDay</td>
                                    <td>@(rule.BeneficiaryDisplayName ?? "Koszt wspólny")</td>
                                    <td>
                                        @if (rule.OccurrenceId.HasValue)
                                        {
                                            <span class="family-finance-sharing-pill @(rule.CanPay ? "neutral" : "on")">
                                                @rule.OccurrenceStatusNamePl
                                            </span>
                                            @if (rule.PlannedDateUtc.HasValue)
                                            {
                                                <small class="d-block text-muted mt-1">
                                                    termin @rule.PlannedDateUtc.Value.ToString("dd.MM.yyyy")
                                                </small>
                                            }
                                        }
                                        else
                                        {
                                            <span class="family-finance-sharing-pill neutral">
                                                Nie przypada w tym miesiącu
                                            </span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        @if (rule.CanPay && rule.OccurrenceId.HasValue)
                                        {
                                            <a asp-action="PayExpense"
                                               asp-route-familyGroupId="@overview.SelectedFamilyGroupId"
                                               asp-route-occurrenceId="@rule.OccurrenceId.Value"
                                               asp-route-year="@overview.Year"
                                               asp-route-month="@overview.Month"
                                               class="btn btn-sm btn-primary me-1">
                                                Opłać
                                            </a>
                                        }
                                        @if (canManage && rule.IsActive)
                                        {
                                            <form asp-action="DeactivateExpense" method="post" class="d-inline">
                                                <input type="hidden" name="ruleId" value="@rule.RuleId" />
                                                <input type="hidden" name="familyGroupId" value="@overview.SelectedFamilyGroupId" />
                                                <input type="hidden" name="year" value="@overview.Year" />
                                                <input type="hidden" name="month" value="@overview.Month" />
                                                <button type="submit" class="btn btn-sm btn-outline-secondary">
                                                    Zakończ
                                                </button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            </section>

            <section class="family-finance-section">
                <div class="family-finance-section-heading">
                    <div>
                        <div class="family-finance-section-number">03</div>
                        <h2>Plan i wykonanie według kategorii</h2>
                        <p>Jedna operacja źródłowa może być zaliczona do tej rodziny tylko raz.</p>
                    </div>
                </div>

                @if (Model.Budget.Categories.Count == 0)
                {
                    <div class="family-finance-inline-empty">Brak kosztów w wybranym miesiącu.</div>
                }
                else
                {
                    <div class="family-finance-category-grid">
                    @foreach (var category in Model.Budget.Categories)
                    {
                        <article class="family-finance-category-card">
                            <strong>@category.CategoryNamePl</strong>
                            <div><span>Plan</span><b>@category.PlannedAmount.ToString("N2") zł</b></div>
                            <div><span>Wykonanie</span><b>@category.ActualAmount.ToString("N2") zł</b></div>
                        </article>
                    }
                    </div>
                }
            </section>

            @if (Model.Budget.ChildCosts.Count > 0)
            {
                <section class="family-finance-section">
                    <div class="family-finance-section-heading">
                        <div>
                            <div class="family-finance-section-number">04</div>
                            <h2>Koszty dzieci</h2>
                            <p>Dziecko nie potrzebuje konta logowania ani rachunku bankowego.</p>
                        </div>
                    </div>
                    <div class="family-finance-child-grid">
                    @foreach (var child in Model.Budget.ChildCosts)
                    {
                        <article class="family-finance-child-card">
                            <strong>@child.DisplayName</strong>
                            <span>Plan: @child.PlannedAmount.ToString("N2") zł</span>
                            <span>Wykonanie: @child.ActualAmount.ToString("N2") zł</span>
                        </article>
                    }
                    </div>
                </section>
            }

            <section class="family-finance-section">
                <div class="family-finance-section-heading">
                    <div>
                        <div class="family-finance-section-number">05</div>
                        <h2>Rzeczywiste wydatki w budżecie</h2>
                        <p>
                            Budżet wskazuje źródło, ale nie tworzy kopii transakcji.
                            Dla prywatnych wydatków nie pokazujemy rodzinie pełnej historii ani kontrahenta.
                        </p>
                    </div>
                    <a asp-action="BudgetLinks"
                       asp-route-familyGroupId="@overview.SelectedFamilyGroupId"
                       asp-route-year="@overview.Year"
                       asp-route-month="@overview.Month"
                       class="btn btn-sm btn-outline-primary">
                        Zarządzaj powiązaniami
                    </a>
                </div>

                @if (Model.Budget.ActualExpenseLinks.Count == 0)
                {
                    <div class="family-finance-inline-empty">Brak powiązanych rzeczywistych wydatków.</div>
                }
                else
                {
                    <div class="table-responsive family-finance-table-wrap">
                        <table class="table family-finance-table align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Źródło</th>
                                    <th>Kategoria</th>
                                    <th>Osoba</th>
                                    <th>Beneficjent</th>
                                    <th class="text-end">Kwota</th>
                                </tr>
                            </thead>
                            <tbody>
                            @foreach (var link in Model.Budget.ActualExpenseLinks)
                            {
                                <tr>
                                    <td>@link.SourceLabel</td>
                                    <td>@link.CategoryNamePl</td>
                                    <td>@(link.PersonDisplayName ?? "Budżet domu")</td>
                                    <td>@(link.BeneficiaryDisplayName ?? "—")</td>
                                    <td class="text-end"><strong>@((link.Amount ?? 0m).ToString("N2")) zł</strong></td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            </section>
        }

        <section class="family-finance-section family-finance-privacy-note @(Model.SelectedTab == "overview" ? "" : "d-none")">
            <div class="family-finance-section-number">06</div>
            <div>
                <h2>Prywatność jest domyślna</h2>
                <p>
                    Członkostwo w rodzinie nie ujawnia salda konta ani pełnej historii
                    transakcji. Dorosły sam włącza osobno planowane przychody,
                    rzeczywiste przychody, przyszłe wydatki rodzinne i reguły cykliczne.
                </p>
            </div>
        </section>
    }
</div>
