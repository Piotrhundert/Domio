@model Domio.Web.Models.HouseholdFinance.CreateHouseholdAccountViewModel
@{
    ViewData["Title"] = "Dodaj konto domu";
}

<div class="household-finance-page household-finance-form-page">
    <div class="household-finance-header">
        <div>
            <div class="household-finance-kicker">
                M04.1 · NOWE KONTO DOMU
            </div>

            <h1>Dodaj konto gospodarstwa</h1>

            <p>
                Utwórz wspólne konto bankowe, gotówkę albo inne konto
                wykorzystywane przez gospodarstwo.
            </p>
        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary">
            Wróć
        </a>
    </div>

    <form asp-action="CreateAccount"
          method="post"
          class="household-finance-form-card">

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3"></div>

        <div class="row g-3">
            <div class="col-md-7">
                <label asp-for="Name"
                       class="form-label"></label>
                <input asp-for="Name"
                       class="form-control"
                       placeholder="np. Konto Dom 1" />
                <span asp-validation-for="Name"
                      class="text-danger small"></span>
            </div>

            <div class="col-md-5">
                <label asp-for="AccountTypeCode"
                       class="form-label"></label>
                <select asp-for="AccountTypeCode"
                        asp-items="Model.AccountTypes"
                        class="form-select">
                </select>
            </div>

            <div class="col-md-4">
                <label asp-for="CurrencyCode"
                       class="form-label"></label>
                <input asp-for="CurrencyCode"
                       class="form-control"
                       maxlength="3" />
                <span asp-validation-for="CurrencyCode"
                      class="text-danger small"></span>
            </div>

            <div class="col-md-8">
                <label asp-for="InitialBalance"
                       class="form-label"></label>
                <div class="input-group">
                    <input asp-for="InitialBalance"
                           class="form-control"
                           type="number"
                           step="0.01"
                           min="0" />
                    <span class="input-group-text">
                        @Model.CurrencyCode
                    </span>
                </div>
                <span asp-validation-for="InitialBalance"
                      class="text-danger small"></span>
                <div class="form-text">
                    Saldo początkowe zostanie zapisane jako osobne
                    księgowanie, a nie jako ręcznie ustawiona wartość salda.
                </div>
            </div>
        </div>

        <div class="household-finance-info">
            Jeśli to pierwsze konto domu, Domio utworzy również
            pierwsze gospodarstwo i przypisze do niego bieżącego
            administratora.
        </div>

        <div class="household-finance-form-actions">
            <a asp-action="Index"
               class="btn btn-outline-secondary">
                Anuluj
            </a>

            <button type="submit"
                    class="btn btn-primary">
                Utwórz konto
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
