@using Domio.Application.Authorization
@using Domio.Domain.HouseholdFinance
@using Domio.Domain.Users
@model Domio.Web.Models.HouseholdFinance.HouseholdContributionIndexViewModel
@{
    ViewData["Title"] = "Składki domowników";

    var overview =
        Model.Overview;

    var canManage =
        overview?.CanManage == true;
}

<div class="household-finance-page">
    <div class="household-finance-header">
        <div>
            <div class="household-finance-kicker">
                M04.3 · CYKLICZNE SKŁADKI
            </div>

            <h1>Składki domowników</h1>

            <p>
                Regułę składki ustawiasz raz. Domio tworzy po jednym
                miesięcznym zobowiązaniu dla każdej reguły i zachowuje
                planowaną kwotę oraz termin jako snapshot miesiąca.
            </p>
        </div>

        <div class="household-finance-header-actions">
            <a asp-action="Index"
               class="btn btn-outline-secondary">
                Wróć do finansów domu
            </a>

            @if (canManage &&
                 overview is not null &&
                 overview.Roles.Count > 0 &&
                 overview.TargetAccounts.Count > 0)
            {
                <a asp-action="CreateContributionRule"
                   class="btn btn-primary">
                    + Dodaj regułę składki
                </a>
            }
        </div>
    </div>

    @if (TempData["HouseholdFinanceMessage"] is string message)
    {
        <div class="alert alert-success mb-4"
             role="alert">
            @message
        </div>
    }

    @if (TempData["HouseholdFinanceError"] is string error)
    {
        <div class="alert alert-danger mb-4"
             role="alert">
            @error
        </div>
    }

    @if (overview is null)
    {
        <div class="household-finance-empty">
            <h2>Brak aktywnego gospodarstwa</h2>
            <p>
                Najpierw utwórz konto domu w module Finanse domu.
            </p>
        </div>
    }
    else
    {
        @if (canManage)
        {
            <section class="household-finance-section">
                <div class="household-finance-section-heading">
                    <div>
                        <div class="household-finance-section-number">01</div>
                        <h2>Role objęte konfiguracją</h2>
                        <p>
                            Regułę ustawiasz dla całej roli. Domio automatycznie
                            tworzy osobną regułę dla każdego aktywnego użytkownika
                            posiadającego tę rolę.
                        </p>
                    </div>
                </div>

                <div class="household-contribution-member-list">
                    @foreach (var role in overview.Roles)
                    {
                        <span class="household-contribution-member-chip">
                            @role.RoleNamePl · @role.UserCount użytk.
                        </span>
                    }
                </div>
            </section>
        }

        <section class="household-finance-section">
                <div class="household-finance-section-heading">
                    <div>
                        <div class="household-finance-section-number">01</div>
                        <h2>Domownicy gospodarstwa</h2>
                        <p>
                            Do gospodarstwa możesz dodać aktywnego użytkownika
                            z rolą Domownik. Dopiero wtedy można utworzyć
                            dla niego regułę składki.
                        </p>
                    </div>
                </div>

                <div class="household-contribution-members">
                    <div class="household-contribution-member-list">
                        @foreach (var member in overview.Members)
                        {
                            <span class="household-contribution-member-chip">
                                @member.DisplayName
                            </span>
                        }
                    </div>

                    @if (Model.CandidatePeople.Count > 0)
                    {
                        <form asp-action="AddHouseholdMember"
                              method="post"
                              class="household-contribution-add-member">

                            <select asp-for="CandidatePersonId"
                                    asp-items="Model.CandidatePeople"
                                    class="form-select">
                                <option value="">Wybierz domownika...</option>
                            </select>

                            <button type="submit"
                                    class="btn btn-outline-primary">
                                Dodaj do gospodarstwa
                            </button>
                        </form>
                    }
                </div>
            </section>
        }

        <section class="household-finance-section">
            <div class="household-finance-section-heading">
                <div>
                    <div class="household-finance-section-number">
                        @(canManage ? "02" : "01")
                    </div>
                    <h2>Reguły składek</h2>
                    <p>
                        Każdy użytkownik wybranej roli otrzymuje osobną
                        regułę. Kwota może być stała albo liczona jako procent
                        jego planowanego wynagrodzenia. Rzeczywista pensja
                        nie zmienia już wygenerowanego zobowiązania.
                    </p>
                </div>
            </div>

            @if (overview.Rules.Count == 0)
            {
                <div class="household-finance-empty compact">
                    <h3>Brak reguł składek</h3>
                    <p>
                        @if (canManage)
                        {
                            <span>
                                Utwórz pierwszą miesięczną regułę składki.
                            </span>
                        }
                        else
                        {
                            <span>
                                Nie masz jeszcze przypisanej reguły składki.
                            </span>
                        }
                    </p>
                </div>
            }
            else
            {
                <div class="household-contribution-rule-grid">
                    @foreach (var rule in overview.Rules)
                    {
                        <article class="household-contribution-rule-card">
                            <div class="household-contribution-rule-top">
                                <div>
                                    <span>@rule.HouseholdMemberName</span>
                                    <h3>@rule.ModeNamePl</h3>
                                </div>

                                <span class="household-account-status @(rule.IsActive ? "is-active" : "is-inactive")">
                                    @(rule.IsActive ? "Aktywna" : "Zakończona")
                                </span>
                            </div>

                            <dl class="household-contribution-rule-details">
                                @if (rule.ModeCode ==
                                     HouseholdContributionModes.FixedAmount)
                                {
                                    <div>
                                        <dt>Kwota</dt>
                                        <dd>
                                            @rule.FixedAmount?.ToString("N2")
                                            @overview.CurrencyCode
                                        </dd>
                                    </div>
                                }
                                else
                                {
                                    <div>
                                        <dt>Procent</dt>
                                        <dd>@rule.Percentage?.ToString("N2")%</dd>
                                    </div>

                                    <div>
                                        <dt>Planowana podstawa</dt>
                                        <dd>
                                            @rule.PlannedIncomeAmount?.ToString("N2")
                                            @overview.CurrencyCode
                                        </dd>
                                    </div>
                                }

                                <div>
                                    <dt>Planowana wypłata</dt>
                                    <dd>
                                        @(rule.PlannedPayDay.HasValue
                                            ? $"{rule.PlannedPayDay}. dzień miesiąca"
                                            : "Oczekuje na wynagrodzenie")
                                    </dd>
                                </div>

                                <div>
                                    <dt>Termin składki</dt>
                                    <dd>
                                        +@rule.DueOffsetDays dni
                                        od planowanej wypłaty
                                    </dd>
                                </div>

                                <div>
                                    <dt>Konto docelowe</dt>
                                    <dd>@rule.TargetHouseholdAccountName</dd>
                                </div>

                                <div>
                                    <dt>Przypomnienie</dt>
                                    <dd>@rule.ReminderDays dni wcześniej</dd>
                                </div>
                            </dl>

                            @if (!rule.IncomeRuleId.HasValue)
                            {
                                <div class="household-contribution-pending-income">
                                    Oczekuje na planowane wynagrodzenie tego użytkownika.
                                    Po jego dodaniu Domio automatycznie przeliczy składkę.
                                </div>
                            }
                        </article>
                    }
                </div>
            }
        </section>

        <section class="household-finance-section">
            <div class="household-finance-section-heading">
                <div>
                    <div class="household-finance-section-number">
                        @(canManage ? "03" : "02")
                    </div>
                    <h2>Miesięczne zobowiązania</h2>
                    <p>
                        Jedna reguła może utworzyć dokładnie jedno
                        zobowiązanie dla danego miesiąca. Ponowne
                        uruchomienie generatora nie tworzy duplikatu.
                    </p>
                </div>
            </div>

            @if (overview.Obligations.Count == 0)
            {
                <div class="household-finance-empty compact">
                    <h3>Brak zobowiązań</h3>
                    <p>
                        Zobowiązania pojawią się po utworzeniu reguły
                        powiązanej z planowanym wynagrodzeniem.
                    </p>
                </div>
            }
            else
            {
                <div class="table-responsive household-finance-table-wrap">
                    <table class="table household-finance-table align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Miesiąc</th>
                                <th>Domownik</th>
                                <th>Termin</th>
                                <th>Tryb / podstawa</th>
                                <th>Konto docelowe</th>
                                <th>Status</th>
                                <th class="text-end">Pozostało</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var obligation in overview.Obligations)
                        {
                            <tr>
                                <td>
                                    <strong>@obligation.PeriodKey</strong>
                                </td>

                                <td>@obligation.HouseholdMemberName</td>

                                <td>
                                    @(obligation.DueDateUtc
                                        .ToLocalTime()
                                        .ToString("dd.MM.yyyy"))
                                </td>

                                <td>
                                    @if (obligation.ModeCode ==
                                         HouseholdContributionModes.PercentageOfIncome)
                                    {
                                        <strong>
                                            @obligation.Percentage?.ToString("N2")%
                                        </strong>
                                        <div class="household-entry-source">
                                            plan:
                                            @obligation.PlannedIncomeAmount?.ToString("N2")
                                            @obligation.CurrencyCode
                                        </div>
                                    }
                                    else
                                    {
                                        <span>Stała kwota</span>
                                    }
                                </td>

                                <td>@obligation.TargetHouseholdAccountName</td>

                                <td>
                                    <span class="household-contribution-status @obligation.StatusCode.ToLowerInvariant()">
                                        @obligation.StatusNamePl
                                    </span>
                                </td>

                                <td class="text-end">
                                    <strong>
                                        @obligation.OutstandingAmount.ToString("N2")
                                        @obligation.CurrencyCode
                                    </strong>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        <div class="household-finance-foundation-note">
            <strong>M04.3 – reguły i zobowiązania.</strong>
            <span>
                Ta paczka nie pobiera jeszcze pieniędzy z prywatnego konta
                domownika. Płatność składki i wpłaty częściowe będą kolejnym
                etapem M04.
            </span>
        </div>
    }
</div>
