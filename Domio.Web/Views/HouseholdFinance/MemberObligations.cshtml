@using Domio.Domain.HouseholdFinance
@model Domio.Application.HouseholdFinance.HouseholdMemberObligationOverview
@{
    ViewData["Title"] = "Dodatkowe zobowiązania domowników";

    var today = DateTime.UtcNow.Date;
    var openObligations =
        Model?.Obligations
            .Where(x =>
                x.OutstandingAmount > 0m &&
                x.StatusCode != HouseholdMemberObligationStatuses.Cancelled)
            .ToArray()
        ?? [];
    var overdueCount = openObligations.Count(x => x.DueDateUtc.Date < today);
    var totalOutstanding = openObligations.Sum(x => x.OutstandingAmount);
    var pendingPayments =
        Model?.PaymentRequests
            .Where(x =>
                x.StatusCode == HouseholdMemberObligationPaymentStatuses.Pending)
            .ToArray()
        ?? [];
}

<div class="household-finance-page">
    <div class="household-finance-header">
        <div>
            <div class="household-finance-kicker">M04.7 · DODATKOWE ZOBOWIĄZANIA</div>
            <h1>Dodatkowe zobowiązania domowników</h1>
            <p>
                Administrator może przypisać domownikowi konkretny udział w fakturze domu
                albo inny koszt wymagający dodatkowego zasilenia budżetu. Samo utworzenie
                zobowiązania nie zmienia żadnego salda.
            </p>
        </div>
        <div class="household-finance-header-actions">
            <a asp-action="Index" class="btn btn-outline-secondary">Wróć do finansów domu</a>
            @if (Model?.CanManage == true)
            {
                <a asp-action="CreateMemberObligation" class="btn btn-primary">+ Dodaj zobowiązanie</a>
            }
        </div>
    </div>

    @if (TempData["HouseholdFinanceMessage"] is string message)
    {
        <div class="alert alert-success mb-4" role="alert">@message</div>
    }
    @if (TempData["HouseholdFinanceError"] is string error)
    {
        <div class="alert alert-danger mb-4" role="alert">@error</div>
    }

    @if (Model is null)
    {
        <div class="household-finance-empty"><h2>Brak aktywnego gospodarstwa</h2></div>
    }
    else
    {
        <div class="household-member-obligation-summary-grid">
            <article class="household-member-obligation-summary-card">
                <span>Otwarte zobowiązania</span>
                <strong>@openObligations.Length</strong>
                <small>z pozostałą kwotą</small>
            </article>
            <article class="household-member-obligation-summary-card @(overdueCount > 0 ? "is-overdue" : null)">
                <span>Po terminie</span>
                <strong>@overdueCount</strong>
                <small>wymaga działania</small>
            </article>
            <article class="household-member-obligation-summary-card">
                <span>Pozostało</span>
                <strong>@totalOutstanding.ToString("N2") <small>@Model.CurrencyCode</small></strong>
                <small>łącznie do zasilenia budżetu</small>
            </article>
            <article class="household-member-obligation-summary-card">
                <span>Wpłaty do akceptacji</span>
                <strong>@pendingPayments.Length</strong>
                <small>nie zmieniły jeszcze salda</small>
            </article>
        </div>

        <section class="household-finance-section">
            <div class="household-finance-section-heading">
                <div>
                    <div class="household-finance-section-number">01</div>
                    <h2>Zobowiązania</h2>
                    <p>Domownik widzi tylko własne zobowiązania. Administrator widzi kwotę, źródło i status, ale nie saldo ani historię prywatnych kont.</p>
                </div>
            </div>

            @if (Model.Obligations.Count == 0)
            {
                <div class="household-finance-empty compact">
                    <h3>Brak dodatkowych zobowiązań</h3>
                    <p>Nie ma jeszcze udziałów w fakturach ani innych dodatkowych kosztów.</p>
                </div>
            }
            else
            {
                <div class="table-responsive household-finance-table-wrap">
                    <table class="table household-finance-table align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Domownik</th><th>Źródło</th><th>Opis</th><th>Termin</th><th>Status</th>
                                <th class="text-end">Kwota</th><th class="text-end">Zapłacono</th><th class="text-end">Pozostało</th><th class="text-end">Akcja</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var obligation in Model.Obligations)
                        {
                            var pending = Model.PaymentRequests.FirstOrDefault(x =>
                                x.ObligationId == obligation.ObligationId &&
                                x.StatusCode == HouseholdMemberObligationPaymentStatuses.Pending);
                            var isOverdue =
                                obligation.OutstandingAmount > 0m &&
                                obligation.StatusCode != HouseholdMemberObligationStatuses.Cancelled &&
                                obligation.DueDateUtc.Date < today;

                            <tr class="@(obligation.StatusCode == HouseholdMemberObligationStatuses.Cancelled ? "household-obligation-cancelled-row" : null)">
                                <td><strong>@obligation.HouseholdMemberName</strong></td>
                                <td>
                                    <span class="household-entry-kind">@obligation.SourceTypeNamePl</span>
                                    @if (!string.IsNullOrWhiteSpace(obligation.SourceInvoiceDisplayName))
                                    {
                                        <div class="household-entry-source">@obligation.SourceInvoiceDisplayName</div>
                                    }
                                </td>
                                <td>
                                    <strong>@obligation.Description</strong>
                                    <div class="household-entry-source">Konto: @obligation.TargetHouseholdAccountName</div>
                                </td>
                                <td>
                                    <span class="@(isOverdue ? "household-invoice-overdue-date" : null)">@(obligation.DueDateUtc.ToLocalTime().ToString("dd.MM.yyyy"))</span>
                                    @if (isOverdue)
                                    {
                                        <div class="household-invoice-overdue-label">Po terminie</div>
                                    }
                                </td>
                                <td>
                                    <span class="household-obligation-status @obligation.StatusCode.ToLowerInvariant()">@obligation.StatusNamePl</span>
                                    @if (pending is not null)
                                    {
                                        <div class="household-obligation-pending-label">Wpłata oczekuje na akceptację</div>
                                    }
                                </td>
                                <td class="text-end">@obligation.Amount.ToString("N2") @obligation.CurrencyCode</td>
                                <td class="text-end">@obligation.PaidAmount.ToString("N2") @obligation.CurrencyCode</td>
                                <td class="text-end"><strong>@obligation.OutstandingAmount.ToString("N2") @obligation.CurrencyCode</strong></td>
                                <td class="text-end">
                                    @if (obligation.IsOwn && obligation.OutstandingAmount > 0m && obligation.StatusCode != HouseholdMemberObligationStatuses.Cancelled && pending is null)
                                    {
                                        <a asp-action="SendMemberObligationPayment" asp-route-id="@obligation.ObligationId" class="btn btn-sm btn-outline-primary">Wyślij wpłatę</a>
                                    }
                                    @if (Model.CanManage && obligation.PaidAmount == 0m && obligation.StatusCode != HouseholdMemberObligationStatuses.Cancelled && pending is null)
                                    {
                                        <form asp-action="CancelMemberObligation" method="post" class="d-inline">
                                            <input type="hidden" name="id" value="@obligation.ObligationId" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Anulować to zobowiązanie? Historia pozostanie zachowana.');">Anuluj</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        <section class="household-finance-section">
            <div class="household-finance-section-heading">
                <div>
                    <div class="household-finance-section-number">02</div>
                    <h2>@(Model.CanApprove ? "Wpłaty do akceptacji i historia" : "Moje wysłane wpłaty")</h2>
                    <p>Wysłanie wpłaty nie zmienia salda. Księgowanie po obu stronach następuje dopiero po akceptacji uprawnionego użytkownika.</p>
                </div>
            </div>

            @if (Model.PaymentRequests.Count == 0)
            {
                <div class="household-finance-empty compact">Brak wysłanych wpłat dla dodatkowych zobowiązań.</div>
            }
            else
            {
                <div class="table-responsive household-finance-table-wrap">
                    <table class="table household-finance-table align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Data</th><th>Domownik</th><th>Zobowiązanie</th><th>Konto źródłowe</th><th>Status</th><th class="text-end">Kwota</th>
                                @if (Model.CanApprove) { <th class="text-end">Decyzja</th> }
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var payment in Model.PaymentRequests)
                        {
                            <tr>
                                <td>@(payment.SubmittedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm"))</td>
                                <td>@payment.HouseholdMemberName</td>
                                <td>@payment.Description</td>
                                <td>@(payment.SourcePersonalAccountName ?? "prywatne konto domownika")</td>
                                <td><span class="household-obligation-status @payment.StatusCode.ToLowerInvariant()">@payment.StatusNamePl</span></td>
                                <td class="text-end"><strong>@payment.Amount.ToString("N2") @payment.CurrencyCode</strong></td>
                                @if (Model.CanApprove)
                                {
                                    <td class="text-end">
                                        @if (payment.StatusCode == HouseholdMemberObligationPaymentStatuses.Pending)
                                        {
                                            <form asp-action="ApproveMemberObligationPayment" method="post" class="d-inline">
                                                <input type="hidden" name="paymentRequestId" value="@payment.PaymentRequestId" />
                                                <button type="submit" class="btn btn-sm btn-outline-success">Akceptuj</button>
                                            </form>
                                            <form asp-action="RejectMemberObligationPayment" method="post" class="d-inline">
                                                <input type="hidden" name="paymentRequestId" value="@payment.PaymentRequestId" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger">Odrzuć</button>
                                            </form>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        <div class="household-finance-foundation-note">
            <strong>M04.7 – dodatkowy udział domownika w kosztach domu.</strong>
            <span>Faktura operatora nadal jest kosztem gospodarstwa. Dodatkowe zobowiązanie jest osobnym procesem zasilenia budżetu przez domownika i może być opłacane częściowo. Administrator nie uzyskuje dostępu do prywatnego salda domownika.</span>
        </div>
    }
</div>
