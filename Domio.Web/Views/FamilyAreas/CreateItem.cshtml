@model Domio.Web.Models.FamilyFinance.CreateFamilyAreaItemViewModel
@{
    ViewData["Title"] = $"Nowa pozycja · {Model.AreaName}";
}

<div class="family-area-page">
    <div class="family-area-header">
        <div>
            <div class="family-finance-kicker">M04.9.2 · @Model.AreaName</div>
            <h1>Dodaj koszt do obszaru</h1>
            <p>
                Pozycja zostanie zapisana jako zwykły koszt rodzinny i automatycznie
                zasili ten obszar oraz główny budżet rodziny.
            </p>
        </div>
    </div>

    <form asp-action="CreateItem"
          method="post"
          class="family-area-form-card">
        <input type="hidden"
               asp-for="FamilyGroupId" />
        <input type="hidden"
               asp-for="AreaId" />

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3"></div>

        <div class="row g-3">
            <div class="col-md-8">
                <label asp-for="Name"
                       class="form-label"></label>
                <input asp-for="Name"
                       class="form-control"
                       placeholder="np. Czesne za przedszkole" />
                <span asp-validation-for="Name"
                      class="text-danger"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="PlannedAmount"
                       class="form-label"></label>
                <input asp-for="PlannedAmount"
                       class="form-control"
                       inputmode="decimal" />
                <span asp-validation-for="PlannedAmount"
                      class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="CategoryCode"
                       class="form-label"></label>
                <select asp-for="CategoryCode"
                        asp-items="Model.Categories"
                        class="form-select"></select>
                <span asp-validation-for="CategoryCode"
                      class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="BeneficiaryPersonId"
                       class="form-label"></label>
                <select asp-for="BeneficiaryPersonId"
                        asp-items="Model.Beneficiaries"
                        class="form-select"></select>
            </div>

            <div class="col-md-4">
                <label asp-for="FrequencyCode"
                       class="form-label"></label>
                <select asp-for="FrequencyCode"
                        asp-items="Model.Frequencies"
                        class="form-select"></select>
                <span asp-validation-for="FrequencyCode"
                      class="text-danger"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="DueDateModeCode"
                       class="form-label"></label>
                <select asp-for="DueDateModeCode"
                        asp-items="Model.DueDateModes"
                        class="form-select"
                        id="family-area-due-mode"></select>
                <span asp-validation-for="DueDateModeCode"
                      class="text-danger"></span>
            </div>

            <div class="col-md-4" id="family-area-specific-day">
                <label asp-for="DueDay"
                       class="form-label"></label>
                <input asp-for="DueDay"
                       class="form-control"
                       min="1"
                       max="31" />
                <span asp-validation-for="DueDay"
                      class="text-danger"></span>
            </div>

            <div class="col-md-4" id="family-area-days-before-end">
                <label asp-for="DaysBeforeEnd"
                       class="form-label"></label>
                <input asp-for="DaysBeforeEnd"
                       class="form-control"
                       min="1"
                       max="27"
                       placeholder="np. 3" />
                <span asp-validation-for="DaysBeforeEnd"
                      class="text-danger"></span>
            </div>


            <div class="col-12">
                <div class="form-text">
                    Dla „końca miesiąca” Domio automatycznie wybierze właściwy ostatni dzień
                    (28/29/30/31). Przy „dni przed końcem” termin jest liczony osobno dla każdego miesiąca.
                </div>
            </div>

            <div class="col-md-2">
                <label asp-for="ActiveFromUtc"
                       class="form-label"></label>
                <input asp-for="ActiveFromUtc"
                       class="form-control" />
            </div>

            <div class="col-md-2">
                <label asp-for="ActiveToUtc"
                       class="form-label"></label>
                <input asp-for="ActiveToUtc"
                       class="form-control" />
            </div>
        </div>

        <div class="family-area-note">
            <strong>@Model.AreaName</strong>
            <span>
                Dodanie tej pozycji nie tworzy kopii kosztu. To jedna reguła wykorzystywana
                jednocześnie przez obszar i budżet rodzinny.
            </span>
        </div>

        <div class="d-flex flex-wrap gap-2 mt-4">
            <button type="submit"
                    class="btn btn-primary">
                Dodaj pozycję
            </button>
            <a asp-action="Details"
               asp-route-id="@Model.AreaId"
               class="btn btn-outline-secondary">
                Anuluj
            </a>
        </div>
    </form>
</div>


@section Scripts {
    <script>
        (() => {
            const mode = document.getElementById("family-area-due-mode");
            const specific = document.getElementById("family-area-specific-day");
            const beforeEnd = document.getElementById("family-area-days-before-end");

            if (!mode || !specific || !beforeEnd) return;

            const refresh = () => {
                specific.hidden = mode.value !== "SpecificDay";
                beforeEnd.hidden = mode.value !== "DaysBeforeEnd";
            };

            mode.addEventListener("change", refresh);
            refresh();
        })();
    </script>
}
