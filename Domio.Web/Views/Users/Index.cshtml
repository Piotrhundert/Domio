@using Domio.Application.Authorization
@using Domio.Domain.Users
@model Domio.Application.Users.UserDirectoryOverview
@{
    ViewData["Title"] = "Użytkownicy";

    var canCreate =
        User.HasClaim(
            DomioClaimTypes.Permission,
            SystemPermissions.UsersCreate);

    var canEdit =
        User.HasClaim(
            DomioClaimTypes.Permission,
            SystemPermissions.UsersEdit);

    var canViewRoles =
        User.HasClaim(
            DomioClaimTypes.Permission,
            SystemPermissions.RolesView);
}

<div class="users-page">
    <div class="users-page-header">
        <div>
            <div class="users-kicker">M02.6 · UŻYTKOWNICY I RBAC</div>
            <h1>Użytkownicy</h1>
            <p>
                Widok i dostępne operacje wynikają z PermissionCode
                przypisanych do aktualnej roli.
            </p>
        </div>

        @if (canCreate)
        {
            <div class="users-header-actions">
                <a asp-action="CreatePerson"
                   class="btn btn-outline-primary">
                    + Dodaj osobę
                </a>
                <a asp-action="Create"
                   class="btn btn-primary">
                    + Dodaj użytkownika
                </a>
            </div>
        }
    </div>

    @if (TempData["UsersMessage"] is string message)
    {
        <div class="alert alert-success mb-4" role="alert">
            @message
        </div>
    }

    <div class="users-summary-grid">
        <div class="users-summary-card">
            <span>Wszystkie konta</span>
            <strong>@Model.TotalUsers</strong>
        </div>
        <div class="users-summary-card">
            <span>Aktywne</span>
            <strong>@Model.ActiveUsers</strong>
        </div>
        <div class="users-summary-card">
            <span>Zablokowane</span>
            <strong>@Model.LockedUsers</strong>
        </div>
        <div class="users-summary-card">
            <span>Osoby bez konta</span>
            <strong>@Model.PeopleWithoutAccountCount</strong>
        </div>
    </div>

    <section class="users-panel">
        <div class="users-panel-heading">
            <div>
                <h2>Konta użytkowników</h2>
                <p>
                    Sam podgląd wymaga Users.View.
                    Edycja kont jest pokazywana tylko przy Users.Edit.
                </p>
            </div>
        </div>

        @if (Model.Users.Count == 0)
        {
            <div class="users-empty">Brak kont użytkowników.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table users-table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Użytkownik</th>
                            <th>Konto</th>
                            <th>Rola</th>
                            <th>Status</th>
                            <th>Ostatnie logowanie</th>
                            @if (canEdit)
                            {
                                <th></th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var user in Model.Users)
                    {
                        var initials = string.Join(
                            string.Empty,
                            user.DisplayName
                                .Split(
                                    ' ',
                                    StringSplitOptions.RemoveEmptyEntries)
                                .Take(2)
                                .Select(x => x[0]))
                            .ToUpperInvariant();

                        <tr>
                            <td>
                                <div class="users-person">
                                    <div class="users-avatar">@initials</div>
                                    <div>
                                        <div class="users-person-name">
                                            @user.DisplayName
                                        </div>
                                        <div class="users-person-meta">
                                            Utworzono:
                                            @(user.CreatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy"))
                                        </div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div class="users-login">@user.LoginName</div>
                                @if (!string.IsNullOrWhiteSpace(user.Email))
                                {
                                    <div class="users-person-meta">@user.Email</div>
                                }
                            </td>
                            <td>
                                <span class="users-role-badge">@user.RoleNamePl</span>
                            </td>
                            <td>
                                @if (!user.IsActive)
                                {
                                    <span class="users-status users-status-inactive">
                                        Wyłączone
                                    </span>
                                }
                                else if (user.IsLocked)
                                {
                                    <span class="users-status users-status-locked">
                                        Zablokowane
                                    </span>
                                }
                                else
                                {
                                    <span class="users-status users-status-active">
                                        Aktywne
                                    </span>
                                }
                            </td>
                            <td>
                                @if (user.LastLoginAtUtc is null)
                                {
                                    <span class="text-secondary">Jeszcze nie</span>
                                }
                                else
                                {
                                    @(user.LastLoginAtUtc.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm"))
                                }
                            </td>
                            @if (canEdit)
                            {
                                <td class="text-end">
                                    <a asp-action="Edit"
                                       asp-route-id="@user.UserId"
                                       class="btn btn-sm btn-outline-secondary">
                                        Edytuj
                                    </a>
                                </td>
                            }
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section class="users-panel mt-4">
        <div class="users-panel-heading">
            <div>
                <h2>Osoby bez konta logowania</h2>
                <p>
                    Konto dla istniejącej osoby można utworzyć tylko
                    z uprawnieniem Users.Create.
                </p>
            </div>
        </div>

        @if (Model.PeopleWithoutAccount.Count == 0)
        {
            <div class="users-empty">
                Wszystkie osoby mają już konto albo nie utworzono dodatkowych osób.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table users-table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Osoba</th>
                            <th>E-mail</th>
                            <th>Telefon</th>
                            <th>Status</th>
                            @if (canCreate)
                            {
                                <th></th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var person in Model.PeopleWithoutAccount)
                    {
                        <tr>
                            <td><strong>@person.DisplayName</strong></td>
                            <td>@(person.Email ?? "—")</td>
                            <td>@(person.Phone ?? "—")</td>
                            <td>
                                @if (person.IsActive)
                                {
                                    <span class="users-status users-status-active">
                                        Aktywna
                                    </span>
                                }
                                else
                                {
                                    <span class="users-status users-status-inactive">
                                        Nieaktywna
                                    </span>
                                }
                            </td>
                            @if (canCreate)
                            {
                                <td class="text-end">
                                    @if (person.IsActive)
                                    {
                                        <a asp-action="CreateForPerson"
                                           asp-route-id="@person.PersonId"
                                           class="btn btn-sm btn-outline-primary">
                                            Utwórz konto
                                        </a>
                                    }
                                </td>
                            }
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>

    @if (canViewRoles)
    {
        <section class="users-panel mt-4">
            <div class="users-panel-heading">
                <div>
                    <h2>Role w Domio</h2>
                    <p>
                        Masz uprawnienie Roles.View — możesz otworzyć
                        szczegółową macierz ról i praw.
                    </p>
                </div>
            </div>

            <div class="role-grid">
                @foreach (var role in Model.Roles)
                {
                    <article class="role-card">
                        <div class="role-card-top">
                            <div class="role-icon">
                                @role.NamePl.Substring(0, 1).ToUpperInvariant()
                            </div>
                            <div>
                                <h3>@role.NamePl</h3>
                                <div class="role-code">@role.Code</div>
                            </div>
                        </div>

                        <p>@role.DescriptionPl</p>

                        <div class="role-footer">
                            <span>
                                Przypisane konta:
                                <strong>@role.AssignedUsers</strong>
                            </span>
                            <a asp-controller="Roles"
                               asp-action="Index"
                               asp-route-roleId="@role.Id"
                               class="small">
                                Szczegóły
                            </a>
                        </div>
                    </article>
                }
            </div>
        </section>
    }
</div>
