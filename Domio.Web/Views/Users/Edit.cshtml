@using Domio.Application.Authorization
@using Domio.Domain.Users
@model Domio.Web.Models.Users.EditUserViewModel
@{
    ViewData["Title"] = "Edytuj użytkownika";

    var canAssignRole =
        User.HasClaim(
            DomioClaimTypes.Permission,
            SystemPermissions.UsersAssignRole);

    var canDisable =
        User.HasClaim(
            DomioClaimTypes.Permission,
            SystemPermissions.UsersDisable);

    var canViewRoles =
        User.HasClaim(
            DomioClaimTypes.Permission,
            SystemPermissions.RolesView);
}

<div class="users-page">
    <div class="user-form-header">
        <div>
            <div class="users-kicker">M02.6 · EDYCJA Z KONTROLĄ UPRAWNIEŃ</div>
            <h1>Edytuj użytkownika</h1>
            <p>
                Dostępne pola administracyjne zależą od PermissionCode
                przypisanych do Twojej roli.
            </p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            Wróć
        </a>
    </div>

    <form asp-action="Edit"
          method="post"
          class="user-form-card">

        <input asp-for="UserId" type="hidden" />
        <input asp-for="RoleNamePl" type="hidden" />

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3"></div>

        <div class="user-form-section">
            <h2>Dane osoby</h2>
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="FirstName" class="form-label"></label>
                    <input asp-for="FirstName" class="form-control" />
                    <span asp-validation-for="FirstName"
                          class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="LastName" class="form-label"></label>
                    <input asp-for="LastName" class="form-control" />
                    <span asp-validation-for="LastName"
                          class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="DisplayName" class="form-label"></label>
                    <input asp-for="DisplayName" class="form-control" />
                    <span asp-validation-for="DisplayName"
                          class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Phone" class="form-label"></label>
                    <input asp-for="Phone" class="form-control" />
                    <span asp-validation-for="Phone"
                          class="text-danger small"></span>
                </div>
            </div>
        </div>

        <div class="user-form-section">
            <h2>Konto i rola</h2>
            <div class="row g-3">
                <div class="col-md-6">
                    <div class="user-role-readonly">
                        <span>Login</span>
                        <strong>@Model.LoginName</strong>
                        <small>
                            Login jest nadany automatycznie i nie zmienia się
                            po edycji imienia lub nazwiska.
                        </small>
                    </div>
                </div>

                <div class="col-md-6">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email"
                           class="form-control"
                           autocomplete="off" />
                    <span asp-validation-for="Email"
                          class="text-danger small"></span>
                </div>

                <div class="col-12">
                    @if (canAssignRole)
                    {
                        <label asp-for="RoleDefinitionId"
                               class="form-label"></label>
                        <select asp-for="RoleDefinitionId"
                                asp-items="Model.Roles"
                                class="form-select">
                        </select>
                        <span asp-validation-for="RoleDefinitionId"
                              class="text-danger small"></span>
                        <div class="form-text">
                            Zmiana wymaga Users.AssignRole i jest audytowana.
                        </div>
                    }
                    else
                    {
                        <input asp-for="RoleDefinitionId"
                               type="hidden" />
                        <div class="user-role-readonly">
                            <span>Rola</span>
                            <strong>@Model.RoleNamePl</strong>
                            <small>
                                Nie masz uprawnienia Users.AssignRole,
                                dlatego rola jest tylko do podglądu.
                            </small>
                        </div>
                    }

                    @if (canViewRoles)
                    {
                        <div class="mt-2">
                            <a asp-controller="Roles"
                               asp-action="Index"
                               asp-route-roleId="@Model.RoleDefinitionId"
                               class="small">
                                Zobacz opis tej roli i jej uprawnienia
                            </a>
                        </div>
                    }
                </div>

                <div class="col-12">
                    @if (canDisable)
                    {
                        <div class="form-check form-switch user-active-switch">
                            <input asp-for="IsActive"
                                   class="form-check-input" />
                            <label asp-for="IsActive"
                                   class="form-check-label"></label>
                        </div>
                        <div class="form-text">
                            Wyłączenie aktywnego konta wymaga Users.Disable.
                        </div>
                    }
                    else
                    {
                        <input asp-for="IsActive"
                               type="hidden" />
                        <div class="user-role-readonly">
                            <span>Status konta</span>
                            <strong>
                                @(Model.IsActive ? "Aktywne" : "Nieaktywne")
                            </strong>
                            <small>
                                Nie masz uprawnienia Users.Disable.
                            </small>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="user-form-actions">
            <a asp-action="Index" class="btn btn-outline-secondary">
                Anuluj
            </a>
            <button type="submit" class="btn btn-primary">
                Zapisz zmiany
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
