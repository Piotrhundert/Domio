@using Domio.Application.Authorization
@using Domio.Domain.Users
@model Domio.Web.Models.Users.EditUserViewModel
@{
    ViewData["Title"] = "Konto i dostęp";

    var canAssignRole =
        User.HasClaim(
            DomioClaimTypes.Permission,
            SystemPermissions.UsersAssignRole);

    var canDisable =
        User.HasClaim(
            DomioClaimTypes.Permission,
            SystemPermissions.UsersDisable);

    var canViewProfile =
        User.HasClaim(
            DomioClaimTypes.Permission,
            SystemPermissions.ProfileViewAll);
}

<div class="users-page">
    <div class="user-form-header">
        <div>
            <div class="users-kicker">M02.7 · KONTO I DOSTĘP</div>
            <h1>Konto i dostęp</h1>
            <p>
                @Model.DisplayName — tutaj zarządzasz wyłącznie kontem,
                rolą i dostępem. Dane osobowe są w oddzielnym profilu.
            </p>
        </div>

        <div class="users-header-actions">
            @if (canViewProfile)
            {
                <a asp-controller="Profiles"
                   asp-action="Details"
                   asp-route-id="@Model.PersonId"
                   class="btn btn-outline-primary">
                    Profil osoby
                </a>
            }

            <a asp-action="Index"
               class="btn btn-outline-secondary">
                Wróć
            </a>
        </div>
    </div>

    <form asp-action="Edit"
          method="post"
          class="user-form-card">

        <input asp-for="UserId" type="hidden" />
        <input asp-for="PersonId" type="hidden" />
        <input asp-for="DisplayName" type="hidden" />
        <input asp-for="RoleNamePl" type="hidden" />

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3"></div>

        <div class="user-form-section">
            <h2>Konto logowania</h2>

            <div class="row g-3">
                <div class="col-md-6">
                    <div class="user-role-readonly">
                        <span>Użytkownik</span>
                        <strong>@Model.DisplayName</strong>
                        <small>
                            Imię, nazwisko i inne dane zmieniasz w profilu.
                        </small>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="user-role-readonly">
                        <span>Login</span>
                        <strong>@Model.LoginName</strong>
                        <small>
                            Login pozostaje stały po utworzeniu konta.
                        </small>
                    </div>
                </div>

                <div class="col-md-6">
                    <label asp-for="Email"
                           class="form-label"></label>
                    <input asp-for="Email"
                           class="form-control"
                           autocomplete="off" />
                    <span asp-validation-for="Email"
                          class="text-danger small"></span>
                    <div class="form-text">
                        To adres konta logowania, niezależny od
                        e-maila kontaktowego w profilu.
                    </div>
                </div>

                <div class="col-md-6">
                    @if (canAssignRole)
                    {
                        <label asp-for="RoleDefinitionId"
                               class="form-label"></label>
                        <select asp-for="RoleDefinitionId"
                                asp-items="Model.Roles"
                                class="form-select">
                        </select>
                        <span asp-validation-for="RoleDefinitionId"
                              class="text-danger small"></span>
                    }
                    else
                    {
                        <input asp-for="RoleDefinitionId"
                               type="hidden" />
                        <div class="user-role-readonly">
                            <span>Rola</span>
                            <strong>@Model.RoleNamePl</strong>
                            <small>
                                Brak uprawnienia Users.AssignRole.
                            </small>
                        </div>
                    }
                </div>

                <div class="col-12">
                    @if (canDisable)
                    {
                        <div class="form-check form-switch user-active-switch">
                            <input asp-for="IsActive"
                                   class="form-check-input" />
                            <label asp-for="IsActive"
                                   class="form-check-label"></label>
                        </div>
                        <div class="form-text">
                            Wyłączenie konta blokuje logowanie,
                            ale nie dezaktywuje i nie usuwa osoby ani jej profilu.
                        </div>
                    }
                    else
                    {
                        <input asp-for="IsActive"
                               type="hidden" />
                        <div class="user-role-readonly">
                            <span>Status konta</span>
                            <strong>
                                @(Model.IsActive ? "Aktywne" : "Nieaktywne")
                            </strong>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="user-form-actions">
            <a asp-action="Index"
               class="btn btn-outline-secondary">
                Anuluj
            </a>
            <button type="submit"
                    class="btn btn-primary">
                Zapisz konto i dostęp
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
