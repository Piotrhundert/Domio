@using Domio.Application.Authorization
@using Domio.Domain.HouseholdFinance
@using Domio.Domain.PersonalFinance
@using Domio.Domain.Users
@model Domio.Web.Models.PersonalFinance.PersonalFinanceIndexViewModel
@{
    ViewData["Title"] = "Finanse osobiste";

    var canManage =
        User.HasClaim(
            DomioClaimTypes.Permission,
            SystemPermissions.FinancePersonalManageOwn);

    var finance =
        Model.Finance;

    var accountNames =
        finance.Accounts.ToDictionary(
            x => x.AccountId,
            x => x.Name);

    var plannedOccurrences =
        finance.RecurringOccurrences
            .Where(x =>
                x.StatusCode ==
                PersonalRecurringOccurrenceStatuses.Planned)
            .OrderBy(x => x.PlannedDateUtc)
            .Take(12)
            .ToArray();

    var correctedSourceIds =
        finance.RecentTransactions
            .Where(x => x.CorrectsTransactionId.HasValue)
            .Select(x => x.CorrectsTransactionId!.Value)
            .ToHashSet();
}

<div class="finance-page">
    <div class="finance-page-header">
        <div>
            <div class="finance-kicker">
                M04.6 · FINANSE OSOBISTE
            </div>
            <h1>Moje finanse</h1>
            <p>
                Prywatne konta i operacje należą wyłącznie
                do zalogowanego użytkownika.
            </p>
        </div>

        @if (canManage)
        {
            <div class="finance-header-actions">
                <a asp-action="History"
                   class="btn btn-outline-secondary">
                    Historia i filtry
                </a>

                @if (finance.Accounts.Count(x => x.IsActive) >= 2)
                {
                    <a asp-action="Transfer"
                       class="btn btn-outline-primary">
                        ↔ Transfer między kontami
                    </a>
                }

                <a asp-action="AddOperation"
                   class="btn btn-outline-primary">
                    + Dodaj operację
                </a>

                <a asp-action="CreateAccount"
                   class="btn btn-primary">
                    + Dodaj konto
                </a>
            </div>
        }
    </div>

    @if (TempData["PersonalFinanceMessage"] is string message)
    {
        <div class="alert alert-success mb-4"
             role="alert">
            @message
        </div>
    }

    @if (TempData["PersonalFinanceError"] is string error)
    {
        <div class="alert alert-danger mb-4"
             role="alert">
            @error
        </div>
    }

    <div class="finance-privacy-note">
        <div class="finance-privacy-icon">
            P
        </div>
        <div>
            <strong>Twoje finanse są prywatne.</strong>
            <span>
                Domio nie pokazuje tych kont innym domownikom
                ani Administratorowi jako cudzych finansów.
            </span>
        </div>
    </div>

    @if (Model.OwnContributionObligations.Count > 0)
    {
        <section class="finance-section finance-contribution-section">
            <div class="finance-section-heading">
                <div>
                    <span class="finance-section-number">
                        DOM
                    </span>
                    <div>
                        <h2>Moja aktualna składka na budżet domu</h2>
                        <p>
                            Pokazujemy tylko składkę za bieżący miesiąc,
                            żeby nie wyświetlać przyszłych zobowiązań.
                        </p>
                    </div>
                </div>

                <a asp-controller="HouseholdFinance"
                   asp-action="Contributions"
                   class="btn btn-sm btn-outline-secondary">
                    Wszystkie składki
                </a>
            </div>

            <div class="finance-contribution-grid">
                @foreach (var contribution in Model.OwnContributionObligations)
                {
                    var pendingPayment =
                        Model.OwnContributionPayments
                            .FirstOrDefault(x =>
                                x.ObligationId ==
                                    contribution.ObligationId &&
                                x.StatusCode ==
                                    HouseholdContributionPaymentStatuses.Pending);

                    var isPaid =
                        contribution.OutstandingAmount <= 0m;

                    <article class="finance-contribution-card @(isPaid ? "is-paid" : "")">
                        <div class="finance-contribution-card-top">
                            <div>
                                <span class="finance-contribution-period">
                                    @contribution.PeriodKey
                                </span>
                                <h3>Składka na budżet domu</h3>
                            </div>

                            <span class="household-contribution-status @contribution.StatusCode.ToLowerInvariant()">
                                @contribution.StatusNamePl
                            </span>
                        </div>

                        <div class="finance-contribution-amount">
                            <span>Pozostało do wpłaty</span>
                            <strong>
                                @contribution.OutstandingAmount.ToString("N2")
                                <small>@contribution.CurrencyCode</small>
                            </strong>
                        </div>

                        <div class="finance-contribution-meta">
                            <div>
                                <span>Pełna składka</span>
                                <strong>
                                    @contribution.Amount.ToString("N2")
                                    @contribution.CurrencyCode
                                </strong>
                            </div>

                            <div>
                                <span>Termin</span>
                                <strong>
                                    @(contribution.DueDateUtc
                                        .ToLocalTime()
                                        .ToString("dd.MM.yyyy"))
                                </strong>
                            </div>

                            <div>
                                <span>Konto domu</span>
                                <strong>@contribution.TargetHouseholdAccountName</strong>
                            </div>
                        </div>

                        @if (!isPaid &&
                             pendingPayment is null &&
                             contribution.ReminderActive)
                        {
                            <div class="finance-contribution-reminder @contribution.ReminderStateCode.ToLowerInvariant()">
                                <strong>@contribution.ReminderStateNamePl</strong>

                                @if (contribution.ReminderStateCode ==
                                     HouseholdContributionReminderStates.Overdue)
                                {
                                    <span>
                                        Do wpłaty pozostało
                                        @contribution.OutstandingAmount.ToString("N2")
                                        @contribution.CurrencyCode.
                                    </span>
                                }
                                else if (contribution.ReminderStateCode ==
                                          HouseholdContributionReminderStates.Upcoming)
                                {
                                    <span>
                                        Termin:
                                        @(contribution.DueDateUtc
                                            .ToLocalTime()
                                            .ToString("dd.MM.yyyy")).
                                    </span>
                                }
                            </div>
                        }

                        <div class="finance-contribution-card-action">
                            @if (isPaid)
                            {
                                <span class="finance-contribution-paid">
                                    ✓ Składka opłacona
                                </span>
                            }
                            else if (pendingPayment is not null)
                            {
                                <span class="finance-contribution-pending">
                                    Wpłata wysłana · oczekuje na akceptację administratora
                                </span>
                            }
                            else if (Model.CanPayContributions)
                            {
                                <a asp-controller="HouseholdFinance"
                                   asp-action="SendContributionPayment"
                                   asp-route-obligationId="@contribution.ObligationId"
                                   class="btn btn-primary btn-sm">
                                    Wyślij wpłatę
                                </a>
                            }
                        </div>
                    </article>
                }
            </div>
        </section>
    }

    <section class="finance-section">
        <div class="finance-section-heading">
            <div>
                <span class="finance-section-number">
                    01
                </span>
                <div>
                    <h2>Moje konta</h2>
                    <p>
                        Saldo jest wyliczane z zapisanej historii
                        operacji, a nie przechowywane jako osobna
                        nadpisywana wartość.
                    </p>
                </div>
            </div>
        </div>

        @if (finance.Accounts.Count == 0)
        {
            <div class="finance-empty">
                <div class="finance-empty-icon">
                    +
                </div>
                <h3>Nie masz jeszcze konta finansowego</h3>
                <p>
                    Zacznij od utworzenia konta bankowego,
                    oszczędnościowego albo gotówkowego.
                </p>

                @if (canManage)
                {
                    <a asp-action="CreateAccount"
                       class="btn btn-primary">
                        Utwórz pierwsze konto
                    </a>
                }
            </div>
        }
        else
        {
            <div class="finance-account-grid">
                @foreach (var account in finance.Accounts)
                {
                    <article class="finance-account-card">
                        <div class="finance-account-top">
                            <div>
                                <span class="finance-account-type">
                                    @account.AccountTypeNamePl
                                </span>
                                <h3>@account.Name</h3>
                            </div>

                            @if (account.IsActive)
                            {
                                <span class="finance-status-active">
                                    Aktywne
                                </span>
                            }
                            else
                            {
                                <span class="finance-status-inactive">
                                    Zamknięte
                                </span>
                            }
                        </div>

                        <div class="finance-balance">
                            <span>Saldo</span>
                            <strong>
                                @account.Balance.ToString("N2")
                                <small>@account.CurrencyCode</small>
                            </strong>
                        </div>

                        @if (canManage && account.IsActive)
                        {
                            <div class="finance-account-actions">
                                <a asp-action="AddOperation"
                                   asp-route-accountId="@account.AccountId"
                                   class="finance-account-action">
                                    Dodaj przychód lub wydatek →
                                </a>

                                @if (finance.Accounts.Count(x => x.IsActive) >= 2)
                                {
                                    <a asp-action="Transfer"
                                       asp-route-sourceAccountId="@account.AccountId"
                                       class="finance-account-action">
                                        Przelej z tego konta →
                                    </a>
                                }

                                <a asp-action="CloseAccount"
                                   asp-route-id="@account.AccountId"
                                   class="finance-account-action finance-account-close-action">
                                    Zamknij konto →
                                </a>
                            </div>
                        }
                    </article>
                }
            </div>
        }
    </section>

    <section class="finance-section mt-4">
        <div class="finance-section-heading">
            <div>
                <span class="finance-section-number">
                    02
                </span>
                <div>
                    <h2>Reguły cykliczne</h2>
                    <p>
                        Wynagrodzenie lub subskrypcję definiujesz raz.
                        Domio generuje planowane wystąpienia bez
                        automatycznego księgowania.
                    </p>
                </div>
            </div>
        </div>

        @if (finance.RecurringRules.Count == 0)
        {
            <div class="finance-empty finance-empty-compact">
                Nie masz jeszcze reguł cyklicznych.
            </div>
        }
        else
        {
            <div class="finance-recurring-rule-grid">
                @foreach (var rule in finance.RecurringRules)
                {
                    <article class="finance-recurring-rule-card">
                        <div>
                            <span class="finance-account-type">
                                @rule.KindNamePl · @rule.CategoryNamePl
                            </span>
                            <h3>@rule.Name</h3>
                            <p>
                                @rule.FrequencyNamePl
                                · od
                                @rule.StartDateUtc.ToLocalTime().ToString("dd.MM.yyyy")
                            </p>
                        </div>

                        <div class="finance-recurring-rule-amount">
                            @rule.PlannedAmount.ToString("N2")
                            <small>@rule.CurrencyCode</small>
                        </div>

                        <div class="finance-recurring-rule-meta">
                            <span>
                                Konto: <strong>@rule.AccountName</strong>
                            </span>

                            @if (!string.IsNullOrWhiteSpace(rule.Counterparty))
                            {
                                <span>
                                    Płatnik/usługodawca:
                                    <strong>@rule.Counterparty</strong>
                                </span>
                            }
                        </div>

                        @if (canManage && rule.IsActive)
                        {
                            <div class="finance-recurring-actions">
                                <a asp-action="EditRecurring"
                                   asp-route-id="@rule.RuleId"
                                   class="btn btn-sm btn-outline-primary">
                                    Edytuj
                                </a>

                                <a asp-action="DeleteRecurring"
                                   asp-route-id="@rule.RuleId"
                                   class="btn btn-sm btn-outline-danger">
                                    Usuń / zakończ
                                </a>
                            </div>
                        }
                    </article>
                }
            </div>
        }
    </section>

    <section class="finance-section mt-4">
        <div class="finance-section-heading">
            <div>
                <span class="finance-section-number">
                    03
                </span>
                <div>
                    <h2>Planowane wystąpienia</h2>
                    <p>
                        To plan na kolejne okresy.
                        Po terminie możesz potwierdzić rzeczywisty wpływ
                        albo płatność. Dopiero wtedy zmieni się saldo konta.
                    </p>
                </div>
            </div>
        </div>

        @if (plannedOccurrences.Length == 0)
        {
            <div class="finance-empty finance-empty-compact">
                Brak planowanych wystąpień.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table finance-table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Data</th>
                            <th>Reguła</th>
                            <th>Konto</th>
                            <th>Rodzaj</th>
                            <th>Status</th>
                            <th class="text-end">Planowana kwota</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var occurrence in plannedOccurrences)
                    {
                        var isFutureOccurrence =
                            occurrence.PlannedDateUtc.Date >
                            DateTime.UtcNow.Date;

                        <tr class="@(isFutureOccurrence ? "finance-planned-future-row" : null)">
                            <td>
                                @(occurrence.PlannedDateUtc
                                    .ToLocalTime()
                                    .ToString("dd.MM.yyyy"))
                            </td>
                            <td>
                                <strong>@occurrence.RuleName</strong>
                                <div class="finance-row-meta">
                                    @occurrence.CategoryNamePl
                                </div>
                            </td>
                            <td>@occurrence.AccountName</td>
                            <td>
                                <span class="finance-kind">
                                    @occurrence.KindNamePl
                                </span>
                            </td>
                            <td>
                                @if (occurrence.PlannedDateUtc.Date < DateTime.UtcNow.Date)
                                {
                                    <span class="finance-status-overdue">
                                        Termin minął
                                    </span>
                                }
                                else
                                {
                                    <span class="finance-status-planned">
                                        Planowane
                                    </span>
                                }
                            </td>
                            <td class="text-end">
                                <strong>
                                    @occurrence.PlannedAmount.ToString("N2")
                                    @occurrence.CurrencyCode
                                </strong>
                            </td>
                            <td class="text-end">
                                @if (canManage)
                                {
                                    @if (isFutureOccurrence)
                                    {
                                        <button type="button"
                                                class="btn btn-sm btn-outline-secondary"
                                                disabled
                                                title="To wystąpienie będzie można potwierdzić w dniu planowanej daty lub później.">
                                            @(occurrence.KindCode == PersonalTransactionKinds.Income
                                                ? "Potwierdź wpływ"
                                                : "Potwierdź płatność")
                                        </button>
                                    }
                                    else
                                    {
                                        <a asp-action="ConfirmRecurring"
                                           asp-route-id="@occurrence.OccurrenceId"
                                           class="btn btn-sm btn-outline-primary">
                                            @(occurrence.KindCode == PersonalTransactionKinds.Income
                                                ? "Potwierdź wpływ"
                                                : "Potwierdź płatność")
                                        </a>
                                    }
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section class="finance-section mt-4">
        <div class="finance-section-heading">
            <div>
                <span class="finance-section-number">
                    04
                </span>
                <div>
                    <h2>Ostatnie operacje</h2>
                    <p>
                        Na tym etapie M03.2 rejestrujemy
                        przychody i wydatki. Transfery,
                        korekty i reguły cykliczne dojdą
                        w kolejnych paczkach M03.
                    </p>
                </div>
            </div>
        </div>

        @if (finance.RecentTransactions.Count == 0)
        {
            <div class="finance-empty finance-empty-compact">
                Brak zapisanych operacji.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table finance-table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Data</th>
                            <th>Konto</th>
                            <th>Rodzaj</th>
                            <th>Kategoria / kontrahent</th>
                            <th>Opis</th>
                            <th class="text-end">Kwota</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var transaction in finance.RecentTransactions)
                    {
                        var accountName =
                            accountNames.TryGetValue(
                                transaction.AccountId,
                                out var value)
                                ? value
                                : "Konto";

                        var accountCurrency =
                            finance.Accounts
                                .FirstOrDefault(
                                    x =>
                                        x.AccountId ==
                                        transaction.AccountId)?
                                .CurrencyCode
                            ?? string.Empty;

                        var isExpense =
                            transaction.Amount < 0;

                        <tr>
                            <td>
                                @(transaction.OccurredAtUtc
                                    .ToLocalTime()
                                    .ToString("dd.MM.yyyy"))
                            </td>
                            <td>
                                <strong>@accountName</strong>
                            </td>
                            <td>
                                <span class="finance-kind">
                                    @transaction.KindNamePl
                                </span>

                                @if (transaction.CorrectsTransactionId.HasValue)
                                {
                                    <div class="finance-row-meta">
                                        korekta operacji źródłowej
                                    </div>
                                }
                            </td>
                            <td>
                                <strong>
                                    @(string.IsNullOrWhiteSpace(
                                        transaction.CategoryNamePl)
                                        ? "Bez kategorii"
                                        : transaction.CategoryNamePl)
                                </strong>

                                @if (!string.IsNullOrWhiteSpace(
                                    transaction.Counterparty))
                                {
                                    <div class="finance-row-meta">
                                        @transaction.Counterparty
                                    </div>
                                }
                            </td>
                            <td>
                                @(string.IsNullOrWhiteSpace(
                                    transaction.Description)
                                    ? "—"
                                    : transaction.Description)
                            </td>
                            <td class="text-end">
                                <span class="finance-amount @(isExpense ? "is-expense" : "is-income")">
                                    @(transaction.Amount > 0 ? "+" : "")
                                    @transaction.Amount.ToString("N2")
                                    @accountCurrency
                                </span>
                            </td>
                            <td class="text-end">
                                @{
                                    var correctableKind =
                                        transaction.KindCode ==
                                            PersonalTransactionKinds.Income ||
                                        transaction.KindCode ==
                                            PersonalTransactionKinds.Expense ||
                                        transaction.KindCode ==
                                            PersonalTransactionKinds.OpeningBalance;

                                    var alreadyCorrected =
                                        correctedSourceIds.Contains(
                                            transaction.TransactionId);
                                }

                                @if (canManage &&
                                     correctableKind &&
                                     !alreadyCorrected &&
                                     !transaction.CorrectsTransactionId.HasValue)
                                {
                                    <a asp-action="CorrectOperation"
                                       asp-route-id="@transaction.TransactionId"
                                       class="btn btn-sm btn-outline-secondary">
                                        Koryguj
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>
