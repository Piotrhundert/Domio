@model Domio.Web.Models.PersonalFinance.EditPersonalRecurringRuleViewModel
@{
    ViewData["Title"] = "Edytuj operację cykliczną";
}

<div class="finance-page finance-form-page">
    <div class="finance-page-header">
        <div>
            <div class="finance-kicker">
                M03.4 · EDYCJA REGUŁY
            </div>
            <h1>Edytuj operację cykliczną</h1>
            <p>
                Zmiany przeliczają przyszły plan.
                Wcześniejsze wystąpienia, np. pensja planowana
                na 01.09, pozostają bez zmian i nadal można je potwierdzić.
            </p>
        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary">
            Wróć
        </a>
    </div>

    <form asp-action="EditRecurring"
          method="post"
          class="finance-form-card">

        <input asp-for="RuleId" type="hidden" />

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3"></div>

        <div class="finance-form-section">
            <h2>Reguła cykliczna</h2>

            <div class="row g-3">
                <div class="col-md-7">
                    <label asp-for="Name"
                           class="form-label"></label>
                    <input asp-for="Name"
                           class="form-control" />
                    <span asp-validation-for="Name"
                          class="text-danger small"></span>
                </div>

                <div class="col-md-5">
                    <label asp-for="AccountId"
                           class="form-label"></label>
                    <select asp-for="AccountId"
                            asp-items="Model.Accounts"
                            class="form-select">
                    </select>
                </div>

                <div class="col-md-4">
                    <label asp-for="KindCode"
                           class="form-label"></label>
                    <select asp-for="KindCode"
                            asp-items="Model.OperationKinds"
                            class="form-select">
                    </select>
                </div>

                <div class="col-md-4">
                    <label asp-for="PlannedAmount"
                           class="form-label"></label>
                    <input asp-for="PlannedAmount"
                           class="form-control"
                           type="number"
                           step="0.01"
                           min="0.01" />
                    <span asp-validation-for="PlannedAmount"
                          class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="FrequencyCode"
                           class="form-label"></label>
                    <select asp-for="FrequencyCode"
                            asp-items="Model.RecurringFrequencies"
                            class="form-select">
                    </select>
                </div>

                <div class="col-md-6">
                    <label asp-for="CategoryCode"
                           class="form-label"></label>
                    <select asp-for="CategoryCode"
                            asp-items="Model.Categories"
                            class="form-select">
                    </select>
                </div>

                <div class="col-md-6">
                    <label asp-for="Counterparty"
                           class="form-label"></label>
                    <input asp-for="Counterparty"
                           class="form-control" />
                </div>

                <div class="col-md-6">
                    <label asp-for="StartDate"
                           class="form-label"></label>
                    <input asp-for="StartDate"
                           type="date"
                           class="form-control" />
                </div>

                <div class="col-md-6">
                    <label asp-for="EndDate"
                           class="form-label"></label>
                    <input asp-for="EndDate"
                           type="date"
                           class="form-control" />
                </div>
            </div>
        </div>

        <div class="finance-form-info">
            Edycja nie zmienia już istniejących wystąpień
            z terminem wcześniejszym niż dzisiaj.
            Dzięki temu historyczny plan pozostaje czytelny.
        </div>

        <div class="finance-form-actions">
            <a asp-action="Index"
               class="btn btn-outline-secondary">
                Anuluj
            </a>

            <button type="submit"
                    class="btn btn-primary">
                Zapisz zmiany
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
