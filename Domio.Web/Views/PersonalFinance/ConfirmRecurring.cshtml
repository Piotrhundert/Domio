@using Domio.Domain.PersonalFinance
@model Domio.Web.Models.PersonalFinance.ConfirmRecurringOccurrenceViewModel
@{
    ViewData["Title"] = "Potwierdź operację cykliczną";

    var isIncome =
        Model.KindCode ==
        PersonalTransactionKinds.Income;
}

<div class="finance-page finance-form-page">
    <div class="finance-page-header">
        <div>
            <div class="finance-kicker">
                M03.4 · POTWIERDZENIE
            </div>
            <h1>
                @(isIncome
                    ? "Potwierdź wpływ pieniędzy"
                    : "Potwierdź płatność")
            </h1>
            <p>
                Plan pozostanie w historii,
                ale saldo zmieni się dopiero po tym potwierdzeniu.
            </p>
        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary">
            Wróć
        </a>
    </div>

    <form asp-action="ConfirmRecurring"
          method="post"
          class="finance-form-card">

        <input asp-for="OccurrenceId" type="hidden" />
        <input asp-for="RuleName" type="hidden" />
        <input asp-for="AccountName" type="hidden" />
        <input asp-for="KindCode" type="hidden" />
        <input asp-for="KindNamePl" type="hidden" />
        <input asp-for="CurrencyCode" type="hidden" />
        <input asp-for="PlannedAmount" type="hidden" />
        <input asp-for="PlannedDate" type="hidden" />

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3 px-4 pt-4"></div>

        <div class="finance-confirm-plan">
            <div>
                <span>Reguła</span>
                <strong>@Model.RuleName</strong>
            </div>

            <div>
                <span>Konto</span>
                <strong>@Model.AccountName</strong>
            </div>

            <div>
                <span>Planowana data</span>
                <strong>
                    @Model.PlannedDate.ToString("dd.MM.yyyy")
                </strong>
            </div>

            <div>
                <span>Planowana kwota</span>
                <strong>
                    @Model.PlannedAmount.ToString("N2")
                    @Model.CurrencyCode
                </strong>
            </div>
        </div>

        <div class="finance-form-section">
            <h2>Dane rzeczywiste</h2>

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="ActualAmount"
                           class="form-label"></label>
                    <div class="input-group">
                        <input asp-for="ActualAmount"
                               type="number"
                               step="0.01"
                               min="0.01"
                               class="form-control" />
                        <span class="input-group-text">
                            @Model.CurrencyCode
                        </span>
                    </div>
                    <span asp-validation-for="ActualAmount"
                          class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="ActualDate"
                           class="form-label"></label>
                    <input asp-for="ActualDate"
                           type="date"
                           class="form-control" />
                    <span asp-validation-for="ActualDate"
                          class="text-danger small"></span>
                </div>

                <div class="col-12">
                    <label asp-for="Description"
                           class="form-label"></label>
                    <textarea asp-for="Description"
                              rows="3"
                              class="form-control"></textarea>
                </div>
            </div>
        </div>

        <div class="finance-form-info">
            @if (isIncome)
            {
                <span>
                    Po potwierdzeniu rzeczywista kwota zostanie
                    dodana do salda konta.
                </span>
            }
            else
            {
                <span>
                    Po potwierdzeniu rzeczywista kwota zostanie
                    odjęta od salda. Jeśli środków jest za mało,
                    Domio zablokuje operację.
                </span>
            }
        </div>

        <div class="finance-form-actions">
            <a asp-action="Index"
               class="btn btn-outline-secondary">
                Anuluj
            </a>

            <button type="submit"
                    class="btn btn-primary">
                @(isIncome
                    ? "Potwierdź wpływ"
                    : "Potwierdź płatność")
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
