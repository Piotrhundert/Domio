@using Domio.Application.Authorization
@using Domio.Domain.Users
@{
    ViewData["Title"] = "Start";

    var role =
        User.FindFirst(DomioClaimTypes.RoleName)?.Value
        ?? "Użytkownik";

    var canViewUsers =
        User.HasClaim(
            DomioClaimTypes.Permission,
            SystemPermissions.UsersView);

    var canViewRoles =
        User.HasClaim(
            DomioClaimTypes.Permission,
            SystemPermissions.RolesView);

    var canViewOwnProfile =
        User.HasClaim(
            DomioClaimTypes.Permission,
            SystemPermissions.ProfileViewOwn) ||
        User.HasClaim(
            DomioClaimTypes.Permission,
            SystemPermissions.ProfileViewAll);

    var canViewPersonalFinance =
        User.HasClaim(
            DomioClaimTypes.Permission,
            SystemPermissions.FinancePersonalViewOwn);

    var canViewHouseholdFinance =
        User.HasClaim(
            DomioClaimTypes.Permission,
            SystemPermissions.FinanceHouseholdView);
}

<div class="container-fluid px-4 py-4">
    <div class="domio-welcome">
        <div class="domio-welcome-main">
            <div class="domio-welcome-logo-wrap">
                <img src="~/images/domio-logo.png"
                     alt="Logo Domio"
                     class="domio-welcome-logo" />
            </div>
            <div>
                <div class="domio-kicker">DOMIO</div>
                <h1>Witaj, @User.Identity?.Name</h1>
                <p>
                    Jesteś zalogowany jako <strong>@role</strong>.
                    Finanse osobiste pozostają prywatne,
                    a finanse domu działają jako odrębny wspólny obszar.
                </p>
            </div>
        </div>

        <div class="domio-status-badge">
            M04.5 · Terminy, zaległości i przypomnienia składek
        </div>
    </div>

    <div class="row g-3 mt-2">
        <div class="col-md-6 col-xl-3">
            @if (canViewPersonalFinance)
            {
                <a asp-controller="PersonalFinance"
                   asp-action="Index"
                   class="domio-module-card domio-module-card-link">
                    <div class="domio-module-icon">F</div>
                    <h2>Finanse osobiste</h2>
                    <p>
                        Prywatne konta, salda,
                        przychody i wydatki.
                    </p>
                    <span class="badge text-bg-primary">
                        Otwórz finanse
                    </span>
                </a>
            }
            else
            {
                <div class="domio-module-card">
                    <div class="domio-module-icon">F</div>
                    <h2>Finanse osobiste</h2>
                    <p>
                        Twoja rola nie ma dostępu
                        do finansów osobistych.
                    </p>
                    <span class="badge text-bg-light">
                        Brak dostępu
                    </span>
                </div>
            }
        </div>

        <div class="col-md-6 col-xl-3">
            @if (canViewHouseholdFinance)
            {
                <a asp-controller="HouseholdFinance"
                   asp-action="Index"
                   class="domio-module-card domio-module-card-link">
                    <div class="domio-module-icon">D</div>
                    <h2>Finanse domu</h2>
                    <p>
                        Wspólne konta, gotówka,
                        wpływy i wydatki gospodarstwa.
                    </p>
                    <span class="badge text-bg-primary">
                        Otwórz finanse domu
                    </span>
                </a>
            }
            else
            {
                <div class="domio-module-card">
                    <div class="domio-module-icon">D</div>
                    <h2>Finanse domu</h2>
                    <p>
                        Twoja rola nie ma dostępu
                        do wspólnych finansów.
                    </p>
                    <span class="badge text-bg-light">
                        Brak dostępu
                    </span>
                </div>
            }
        </div>

        <div class="col-md-6 col-xl-3">
            @if (canViewOwnProfile)
            {
                <a asp-controller="Profiles"
                   asp-action="My"
                   class="domio-module-card domio-module-card-link">
                    <div class="domio-module-icon">P</div>
                    <h2>Mój profil</h2>
                    <p>
                        Dane osobowe, kontakt, adres,
                        dokument i osoba kontaktowa.
                    </p>
                    <span class="badge text-bg-primary">
                        Otwórz profil
                    </span>
                </a>
            }
            else
            {
                <div class="domio-module-card">
                    <div class="domio-module-icon">P</div>
                    <h2>Mój profil</h2>
                    <p>
                        Twoja rola nie ma dostępu do profilu.
                    </p>
                    <span class="badge text-bg-light">
                        Brak dostępu
                    </span>
                </div>
            }
        </div>

        <div class="col-md-6 col-xl-3">
            @if (canViewUsers)
            {
                <a asp-controller="Users"
                   asp-action="Index"
                   class="domio-module-card domio-module-card-link">
                    <div class="domio-module-icon">U</div>
                    <h2>Użytkownicy</h2>
                    <p>
                        Osoby, konta i dostęp.
                    </p>
                    <span class="badge text-bg-primary">
                        Otwórz panel
                    </span>
                </a>
            }
            else
            {
                <div class="domio-module-card">
                    <div class="domio-module-icon">U</div>
                    <h2>Użytkownicy</h2>
                    <p>
                        Brak uprawnienia Users.View.
                    </p>
                    <span class="badge text-bg-light">
                        Brak dostępu
                    </span>
                </div>
            }
        </div>

        <div class="col-md-6 col-xl-3">
            @if (canViewRoles)
            {
                <a asp-controller="Roles"
                   asp-action="Index"
                   class="domio-module-card domio-module-card-link">
                    <div class="domio-module-icon">R</div>
                    <h2>Role i uprawnienia</h2>
                    <p>
                        Macierz PermissionCode
                        i zakres dostępu.
                    </p>
                    <span class="badge text-bg-primary">
                        Otwórz panel
                    </span>
                </a>
            }
            else
            {
                <div class="domio-module-card">
                    <div class="domio-module-icon">R</div>
                    <h2>Role i uprawnienia</h2>
                    <p>
                        Brak uprawnienia Roles.View.
                    </p>
                    <span class="badge text-bg-light">
                        Brak dostępu
                    </span>
                </div>
            }
        </div>
    </div>
</div>
